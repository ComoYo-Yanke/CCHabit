/*
 * 自定义 tabBar。
 * 注意：自定义 tabBar 由框架独立挂载，继承不到 page 上的 CSS 变量，
 * 所以底色与描边由 index.js 用行内样式写（跟主题走），
 * 这里保留的深色值只是行内样式缺失时的兜底，不是唯一来源。
 *
 * 文字与图标不带主题：置灰态 #6B7280 在深色和白色底上都有 4.6:1 以上对比度，
 * 选中态的 #5B8CFF 正是所有 *-active 图标的烘焙色（SVG 里写死的），
 * 换掉它反而会让文字和旁边的图标对不上。
 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  background: #161A22;
  border-top: 1rpx solid #1F242F;
}

.tabbar-inner {
  display: flex;
  align-items: center;
  height: 106rpx;
}

.tabbar-safe {
  /* 同上：env() 解析失败时退化为 0，至少不会把 tabBar 撑坏 */
  height: 0;
  height: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
  transition: transform 0.18s ease;
}

.tab-text {
  font-size: 20rpx;
  color: #6B7280;
  transition: color 0.18s ease;
}

.tab--on .tab-text {
  color: #5B8CFF;
  font-weight: 600;
}

.tab--on .tab-icon {
  transform: translateY(-2rpx);
}

.tab:active {
  opacity: 0.6;
}
