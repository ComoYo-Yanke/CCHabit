/* app.wxss —— 全局样式：深色暗黑主题设计变量 + 通用类 */

@import "styles/icons.wxss";

/* ============ 设计变量（深色调色板 = 默认值） ============ */
/*
 * ⚠️ 这里的值只在「没写 page-style 时」生效。页面挂载时会用
 * <page-meta page-style="{{themeStyle}}"> 把当前主题的变量写成 page 的行内样式，
 * 内联样式优先级更高，会整体盖掉这一块。两边的变量名必须逐字对应。
 *
 * 因此**新增一个变量要同时改两处**：这里（深色）和 utils/theme.js 的 THEMES
 * （深色 + 浅色）。只加在这里的话，浅色主题下这一处会悄悄退回深色值。
 */
page {
  /* 背景层级：page < surface < surface-2 < surface-3 */
  --bg: #0E1014;
  --surface: #171B24;
  --surface-2: #1E232E;
  --surface-3: #262C38;
  --border: #262C38;
  --border-soft: #1F242F;

  /* 文字层级 */
  --text: #EDF1F7;
  --text-2: #98A2B3;
  --text-3: #667085;

  /* 主题色 */
  --accent: #5B8CFF;
  --accent-soft: rgba(91, 140, 255, 0.16);
  --success: #37D0A0;
  --success-soft: rgba(55, 208, 160, 0.16);
  --warn: #FFB020;
  --warn-soft: rgba(255, 176, 32, 0.16);
  --danger: #FF5C5C;
  --danger-soft: rgba(255, 92, 92, 0.16);

  /* 热力图色阶（未打卡 → 高频） */
  --heat-0: #21262F;
  --heat-1: #2B4A7A;
  --heat-2: #3A6FB8;
  --heat-3: #4F8CE0;
  --heat-4: #7FB2FF;
  /* 「没打卡」那一格的底色。浅/深两套在 utils/theme.js 里是真值（半透明的白 / 黑），
     自定义主题取不到那个键，于是退回 --heat-0 —— 它的卡片不透明，本来就是对的 */
  --heat-empty: var(--heat-0);

  /* 没法只靠上面的色值拼出来的几处，直接存整段值（浅色主题换成对应的一套，见 utils/theme.js） */
  --grad-top: linear-gradient(180deg, #161C2B 0%, rgba(14, 16, 20, 0) 100%);
  --grad-card-from: #1B2334;
  --grad-card-to: #171B24;
  --inset-bg: rgba(0, 0, 0, 0.18);
  --ring: rgba(255, 255, 255, 0.7);
  --nav-bg: rgba(14, 16, 20, 0.92);

  /* 弹层专用的那一套（比上面五个更实，自定义主题下两者才会分道扬镳）：见 .sheet */
  --popup-surface: #171B24;
  --popup-surface-2: #1E232E;
  --popup-surface-3: #262C38;
  --popup-border: #262C38;
  --popup-border-soft: #1F242F;

  /* 卡片毛玻璃的模糊半径（见 .card）。这里给的是深 / 浅色那两套用的值：
     它们的卡片不透明，糊不出任何效果，只有自定义主题才真的会用到 */
  --card-blur: 16px;

  /*
   * 液态玻璃（1.3.0）。浅色 / 深色两套在 utils/theme.js 的 THEMES 里另有真值，
   * 会随 page-style 覆盖到这里。
   *
   * ⚠️ 这里的默认值是**故意**写成「改动前的那句」的：自定义主题不走 THEMES，
   * 也拿不到这几个键，于是取到的就是 --surface / --surface-2 这些原值 ——
   * 各处从 `background: var(--surface)` 改成 `background: var(--glass-card)` 之后，
   * 自定义主题算出来的结果和改动前逐像素一致。**别把这几行换成真的玻璃值**，
   * 换了就等于连自定义主题一起改了。
   */
  --glass-card: var(--surface);
  --glass-soft: var(--surface-2);
  --glass-accent: var(--accent);
  --glass-seg-on: var(--surface-3);
  --glass-sheet: var(--popup-surface);
  --glass-edge: var(--border-soft);
  --glass-overview: linear-gradient(135deg, var(--grad-card-from) 0%, var(--grad-card-to) 60%);
  /* 后四个默认是「什么也不加」：这几处原本没有投影 / 内阴影 / 辉光 / 缩放，
     值写成 none / 1 就等于没改，自定义主题因此一点都碰不到 */
  --glass-shadow: none;
  --glass-inset: none;
  --glass-ambient: none;
  --glass-press: 1;
  --glass-press-card: 1;
  --glass-accent-shadow: none;
  --glass-sat: 140%;
  --glass-track: var(--surface-2);
  --glass-track-edge: var(--border-soft);
  /* 会滑动的那块玻璃「扭一下身后的底色」。默认 none = 什么都不做 */
  --glass-warp: none;

  /* 圆角与间距：与主题无关，因此不在 utils/theme.js 里 */
  --r-sm: 12rpx;
  --r-md: 20rpx;
  --r-lg: 28rpx;
  --r-xl: 36rpx;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

/* ============ 布局骨架 ============ */
.page {
  min-height: 100vh;
  /* 底色。那层彩色辉光挪到下面的 .page::before 去了（见那里的注释） */
  background-color: var(--bg);
  /*
   * position + z-index 只有一个目的：让 .page 成为一个层叠上下文。
   * 里面的背景图层（components/app-bg）靠 z-index: -1 压在内容之下，
   * 而负 z-index 的后代只有在这个元素自己是层叠上下文时，才会画在它的
   * **背景之上**；否则它会一路落到根层叠上下文里，被 .page 自己的
   * background 盖住 —— 表现就是「设置了背景图却什么也看不到」。
   *
   * 这里没有用 transform：那会让 .page 变成 fixed 后代的包含块
   * （见 README 决策 15 / 16），底栏、悬浮按钮、弹层全在页面根节点下，
   * 一旦包含块变了就会跟着页面滚。position 没有这个副作用。
   */
  position: relative;
  z-index: 0;
  /* 底部预留悬浮胶囊导航的高度。胶囊是浮在内容之上的（不占布局），
     所以这里必须把它的高度让出来，否则最后一张卡片会被压在底下。
     高度构成 = 离底 20rpx + 胶囊 108rpx + 24rpx 透气 = 152rpx。
     胶囊去掉了文字，比原来矮了约 20rpx（构成见 custom-tab-bar/index.wxss）。
     先写不带 env() 的兜底值：env() 参与 calc 若解析失败整条声明会被丢弃，
     那样底部内容就会被胶囊压住。第二行生效时以后者为准。 */
  padding-bottom: 152rpx;
  padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
}

/*
 * 底色之上那层彩色辉光（液态玻璃的「背景参考」）。
 *
 * 为什么是 position: fixed 的伪元素而不是 .page 自己的 background-image：
 *   1. 铺满**视口**且不随内容滚动 —— 卡片滑过去时后面的光是「透出来的」，
 *      这才像玻璃；贴在 .page 上的话，长页面一屏之后就再没有光了。
 *   2. fixed 后代只有落在层叠上下文里才画得对，.page 正好是（见上面那段注释）。
 *      z-index: -1 让它压在内容之下、.page 自己的底色之上。
 *   3. 用伪元素不占节点 —— 比插一个 <view> 便宜。
 *
 * 形状是四个大半径的径向渐变（蓝 / 紫 / 青 / 粉），**没有动画、没有 filter: blur**：
 * 静态渐变由 WebView 一次绘制缓存，几乎零成本；而动画 + 大半径模糊在真机上
 * 是每秒重绘一整屏，正是要避开的东西。观感上的「流动」靠卡片毛玻璃去折射它。
 *
 * ⚠️ 这是 fixed 的：祖先只要出现 transform / filter / will-change，包含块就会变，
 * 这层会退回「跟着 .page 一起滚」。.page 上不写这些属性（见上面那段），
 * 唯一会动的是页面淡出用的 opacity，不影响包含块。
 *
 * --glass-ambient 只有浅色 / 深色两套有真值，自定义主题是 none —— 那边保持原样。
 */
.page::before {
  content: '';
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: -1;
  pointer-events: none;
  background-image: var(--glass-ambient);
  background-repeat: no-repeat;
}

.page--no-tabbar {
  padding-bottom: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/*
 * 各页顶上那行名言（内容来自 utils/quotes.js）。
 *
 * 主页 /「我的」/ 统计那三页有自己的 .hero，那行字就长在头部里（各自的 .hero-quote）；
 * 其余几页顶上是 nav-bar，没有可依附的头部，所以给一条**独立的横条**：
 * 在 .page 里放一个空 view 即可。字号、颜色、截断都跟着主页那一行走 ——
 * 同一句小字在各页长得不一样才是怪事。
 */
.quote-line {
  padding: 20rpx 28rpx 0;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-3);
}

/* ============ 自定义主题的背景图那一层 ============ */
/*
 * 由 components/app-bg 渲染，必须是 `.page` 的第一个子节点：
 *   - 在 .page 里面，才会跟着页面一起淡出（不然切页时背景图会杵在原地）；
 *   - fixed 而不是 absolute，是为了让图不跟着内容滚 —— 滚起来图不动才像壁纸；
 *   - z-index: -1 压在内容之下。这要求 .page 自己是层叠上下文（见上面 .page 的注释），
 *     否则会被 .page 的背景盖住、整层看不见。
 * 类名写在全局而不是组件里：「自定义主题」编辑页要实时预览同一层，两边共用一套。
 */
.app-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  overflow: hidden;
  /* 图铺满整屏，挡在下面就等于整页点不动 */
  pointer-events: none;
}

/*
 * 图那一层。要裁出「用户选的那一段」，所以它**不是**铺满屏幕的：
 * 它是一张比屏幕大的整图，尺寸 / left / top 全由 utils/theme.js 的 bgLayer 算好
 * 写在行内 style 上，这儿只负责把它绝对定位到 .app-bg 里、被 .app-bg 裁掉溢出部分。
 * 宽高这里一个字都不写死 —— 写死就会盖掉行内样式里的实际几何。
 */
.app-bg-img {
  position: absolute;
}

/* 压在图上的一层底色：越实字越清楚，越透图越明显（在编辑页里可调） */
.app-bg-scrim {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.scroll-body {
  height: 100vh;
  box-sizing: border-box;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* ============ 卡片 ============ */
/*
 * 毛玻璃。两层意思：卡片底色本来就是半透明的（自定义主题里那根「卡片透明度」滑块，
 * 见 utils/theme.js 的 buildCustom），再加上把**卡片背后**的内容糊掉 ——
 * 少了后面这步，背景图会清清楚楚地映在卡片里，字压在上面反而更难读。
 *
 * 深 / 浅色两套里看不出来：它们的 --surface 恒为不透明，背后什么都没有。
 * 它正是在「自定义主题 + 背景图 + 调低卡片透明度」那一档才生效的。生效需要
 * 背景图层和卡片在同一个层叠上下文里 —— 它们都在 .page 内（见 .app-bg 的注释）。
 *
 * 基础库不支持时会静默忽略这一条，卡片就退回现在这样（看得出图、不糊），
 * 所以这是一条**只有加分项**的声明，不需要按平台判断。
 *
 * 半径默认 16px（--card-blur，编辑页有滑块的：大到能读出「糊了」，又不至于把背后的图
 * 糊成一片纯色而失去质感；调到 0 就是一层不糊的半透明卡片）。
 * 别指望加在 .sheet 上 —— 弹层底下垫着遮罩（见 .sheet），糊一块黑色什么也换不来。
 */
.card {
  /* 液态玻璃：上亮下暗的半透明渐变 + 一圈细描边 + 内高光。
     自定义主题下 --glass-card 就是 --surface，即改动前的样子 */
  background: var(--glass-card);
  border-radius: var(--r-lg);
  padding: 28rpx;
  border: 1rpx solid var(--glass-edge);
  box-shadow: var(--glass-shadow);
  /* 饱和度也走 token：自定义主题的卡片同样带毛玻璃（卡片透明度可调），
     在这里写死 180% 会连那一套一起改掉 */
  -webkit-backdrop-filter: blur(var(--card-blur, 16px)) saturate(var(--glass-sat, 140%));
  backdrop-filter: blur(var(--card-blur, 16px)) saturate(var(--glass-sat, 140%));
}

.card + .card {
  margin-top: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.section {
  padding: 0 28rpx;
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.section-sub {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 列表右侧那枚箭头。设置页的「操作列表」和主题编辑页的颜色行都在用，
   所以放在全局而不是某一页里 */
.op-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

/* ============ 文本 ============ */
.t-2 { color: var(--text-2); }
.t-3 { color: var(--text-3); }
.t-accent { color: var(--accent); }
.t-success { color: var(--success); }
.t-danger { color: var(--danger); }
.t-warn { color: var(--warn); }

.f-22 { font-size: 22rpx; }
.f-24 { font-size: 24rpx; }
.f-26 { font-size: 26rpx; }
.f-28 { font-size: 28rpx; }
.f-32 { font-size: 32rpx; }
.f-40 { font-size: 40rpx; }
.f-56 { font-size: 56rpx; }

.bold { font-weight: 600; }
.mono-num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============ 按钮 ============ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  /* 胶囊圆角：演示里的按钮就是胶囊（.btn { border-radius: 999px }） */
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  /* 回弹用带过冲的曲线：松手时玻璃「弹」回原状，而不是匀速复位。
     按下那一刻要跟手，所以在 :active 里换成 0.1s 的直线 —— 按下去快、弹回来慢，
     那点过冲正是演示里最有手感的一处。 */
  transition: opacity 0.15s ease, transform 0.4s cubic-bezier(0.2, 1.5, 0.4, 1.2);
}

.btn--primary {
  /* 有色玻璃：同一色相由浓到淡的渐变 + 自己那圈带色辉光（见 utils/theme.js）。
     自定义主题下 --glass-accent 就是 --accent，仍是实心主色，观感不变 */
  background: var(--glass-accent);
  color: #FFFFFF;
  box-shadow: var(--glass-shadow), var(--glass-accent-shadow);
}

.btn--ghost {
  background: var(--glass-soft);
  color: var(--text);
  box-shadow: var(--glass-shadow);
}

.btn--danger {
  background: var(--danger-soft);
  color: var(--danger);
}

/*
 * 按下时玻璃被「挤压」——**放大**而不是缩小，跟演示一致（.liquid.pressing 是 scale(1.06)），
 * 同时只轻微压一点透明度：透明度压太狠会把「有色玻璃」压暗，那是缩小才该有的观感。
 */
.btn:active {
  opacity: 0.9;
  /* --glass-press 默认是 1，所以自定义主题不缩放 */
  transform: scale(var(--glass-press));
  transition: opacity 0.15s ease, transform 0.1s ease-out;
}

/* ============ 分段控制器 ============ */
/*
 * 选中的那一段不是「自己换个背景色」，而是槽里**独立的一层** .segment::before：
 * 它的位置只由页面上写在 .segment 里的行内变量 --seg-i（第几段）决定，
 * 切换时从当前段**滑**到目标段，而不是闪过去；滑的过程中它还会把身后的底色
 * 扭一下（--glass-warp，演示里那层 blur）。
 *
 * 页面那边要做的只有一件事：在 .segment 上写 style="--seg-i: {{...}}"。
 * 宽度与步长都在这里算 —— 段数默认 4，将来多一段就多写一个 --seg-n。
 */
.segment {
  position: relative;
  display: flex;
  /* 槽是凹的：走 --glass-soft + 内阴影，和卡片的方向相反 */
  background: var(--glass-soft);
  box-shadow: var(--glass-inset);
  border-radius: var(--r-md);
  padding: 6rpx;
  gap: 6rpx;
}

.segment::before {
  content: '';
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  /* 宽 = (槽宽 − 两侧内边距 − (n−1) 个间距) / n；位移一格的步长 = 自己的宽 + 一个间距 */
  width: calc((100% - 12rpx - (var(--seg-n, 4) - 1) * 6rpx) / var(--seg-n, 4));
  border-radius: 14rpx;
  background: var(--glass-seg-on);
  box-shadow: var(--glass-shadow);
  -webkit-backdrop-filter: var(--glass-warp);
  backdrop-filter: var(--glass-warp);
  transform: translateX(calc(var(--seg-i, 0) * (100% + 6rpx)));
  transition: transform 0.42s cubic-bezier(0.2, 1.5, 0.4, 1.18);
  pointer-events: none;
}

.segment-item {
  /* 必须自己成层：滑块也是绝对定位的，不抬一下文字会被它盖住 */
  position: relative;
  z-index: 1;
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-2);
  border-radius: 14rpx;
  transition: color 0.18s ease, transform 0.4s cubic-bezier(0.2, 1.5, 0.4, 1.2);
}

/* 按下也「胀一下」，和 .btn / .press 同一套手感（自定义主题下 --glass-press 是 1，等于没动） */
.segment-item:active {
  transform: scale(var(--glass-press));
  transition: color 0.18s ease, transform 0.1s ease-out;
}

.segment-item--on {
  color: var(--text);
  font-weight: 600;
}

/* ============ 统计数字块 ============ */
.tile {
  flex: 1;
  background: var(--glass-soft);
  box-shadow: var(--glass-shadow);
  border-radius: var(--r-md);
  padding: 24rpx 20rpx;
}

.tile-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.tile-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

/* ============ 空状态 ============ */
.empty {
  padding: 90rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: var(--text-2);
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.7;
}

/* ============ 通用动效 ============ */
/*
 * .press 是「能按的东西」的通用标记（卡片、格子…都挂它）。手感在这一处定，
 * 各组件不必各写一遍：
 *   按下 —— 0.1s 直线，跟手；
 *   松手 —— 0.4s 过冲曲线，玻璃「弹」回原状。
 * 只有 transform 走这条慢曲线：它不触发重排（见 utils/theme.js 那句
 * 「--glass-press 默认是 1」，自定义主题下不缩放，这条过渡也就等于没有）。
 */
.press {
  transition: opacity 0.15s ease, transform 0.4s cubic-bezier(0.2, 1.5, 0.4, 1.2);
}

/*
 * 整张卡片也是可点的（history / settings 里 `class="card press"`）。
 * 它**不能**跟着放大 1.06：全宽卡片放大 6% 会顶出屏幕左右边距，被裁一刀。
 * 所以大块走另一个收敛的系数（--glass-press-card，默认 1）。
 */
.card.press:active {
  transform: scale(var(--glass-press-card));
}

.press:active {
  opacity: 0.7;
  /* 按下时整块「被压一下」。和 .btn 同一个系数，自定义主题下是 1（不缩放） */
  transform: scale(var(--glass-press));
  transition: opacity 0.15s ease, transform 0.1s ease-out;
}

/*
 * 页面切换的淡出 / 淡入（见 utils/page-fade.js 的机制与不变量）。
 *
 * 一个布尔量翻两个方向、两条曲线：
 *   去掉 .page--out → 0 过渡到 1，0.26s 对称 ease-in-out（进场）
 *   加上 .page--out → 1 过渡到 0，0.14s ease-in（退场）
 * 曲线的取向：进场「浮上来」，起步慢、收尾也慢；退场是离开，起步干脆，
 * 拖泥带水反而显得卡。所以退场更短、用 ease-in。
 *
 * **不用 @keyframes**，只用 transition。省掉的是这一串坑：
 *   - 同一属性上动画优先级高于过渡 —— 退场想用 transition 就得先把动画撤掉
 *     （`.page--leaving { animation: none }`），否则页面根本淡不下去；
 *   - animation-fill-mode: forwards 会把 opacity 钉死，同样让退场失效；
 *   - switchTab 的页面一直活着、DOM 不重建，固定 animation-name 不会重播，
 *     于是还得备两份关键帧换名字（pageFadeInA / B + fadeKey）。
 * 现在只需要一个类在不在，浏览器自己就知道该往哪个方向过渡。
 *
 * 只动 opacity，**不要加 transform**：那会让 .page 变成 fixed 子元素的包含块，
 * 页面里的固定定位元素会跟着跑（README 决策 15）。
 *
 * ⚠️ 两条的顺序不能调：元素上两个类同时存在时要靠后面的 .page--out 赢。
 */
.page--fade {
  opacity: 1;
  transition: opacity 0.26s cubic-bezier(0.42, 0, 0.58, 1);
}

.page--out {
  opacity: 0;
  /* 时长与 utils/page-fade.js 的 LEAVE_MS 一致（底栏也是等这么久才 switchTab） */
  transition: opacity 0.14s ease-in;
}

/* ============================================================
   底部弹层（habit-editor / checkin-sheet 共用）
   ============================================================ */
/*
 * 遮罩：**收起时完全不渲染**。
 *
 * 早先写的是 opacity:0 + visibility:hidden，看着等效，其实不是。
 * input / textarea / switch 是**原生组件**，由客户端原生控件画在 WebView 之上，
 * 它们只认「在不在」，不认 opacity / visibility 这类绘制层属性。
 * 于是在收起状态下，弹层里的输入框会以「不完全可见」的形态留在屏幕上 ——
 * 主页偶尔冒出来的那个「背单词」，就是 habit-editor 名称框的 placeholder。
 * 只有 display:none（整棵子树不参与渲染）在所有平台、所有基础库下都成立。
 *
 * 但 display 和 transition 天生不兼容（display 一变过渡就被打断，入场会「跳」），
 * 所以把状态拆成两级：
 *   .mask--mounted  已挂载 —— display:flex，但仍是「收起」姿态（透明 + 弹层在屏幕外）
 *   .mask--on       已展开 —— 透明度和位移一起过渡到位
 * 关闭时先摘 --on 播完退场动画，延迟一会儿再由 JS 摘掉 --mounted 落到 display:none。
 * 万一过渡因为任何原因没跑起来，收起姿态本身也在屏幕外，一样漏不出来。
 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.6);
  /* 关键：不挂载即不渲染，原生组件也留不下来 */
  display: none;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  transition: opacity 0.22s ease;
}

.mask--mounted {
  display: flex;
}

.mask--on {
  opacity: 1;
}

/*
 * 居中弹窗用的遮罩变体：.mask 默认把面板压到底部（justify-content: flex-end），
 * 这里改成屏幕正中。加的是 align-items: center 而不是 padding —— 遮罩是
 * left/top/right/bottom 全 0 的定宽盒子，再挂左右内边距会不会溢出取决于
 * box-sizing 是谁，赌不起；宽度交给 .modal 自己按百分比给。
 */
.mask--center {
  justify-content: center;
  align-items: center;
}

/*
 * 居中的弹窗面板（自定义主题的取景弹窗、首页的更新提示）。
 *
 * 底色那几行和 .sheet 是同一套理由：卡片会跟着 surfaceAlpha 变透明，
 * 而这类面板底下压着 60% 黑的遮罩，跟着透只会「越透越暗」，正文一起糊掉 ——
 * 所以面板自己覆写一整套实心的 --popup-*（详见 .sheet 上的长注释）。
 *
 * 入场只走 transform，不走自己的 opacity：父层 .mask 的透明度是整棵子树一起
 * 合成出去的，面板再写一遍 opacity 只会多一个可能对不齐的时钟。
 */
.modal {
  width: 78%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  /* 内容再长也不许溢出，否则圆角外面会漏出东西 */
  overflow: hidden;
  background: var(--glass-sheet);
  --surface: var(--popup-surface);
  --surface-2: var(--popup-surface-2);
  --surface-3: var(--popup-surface-3);
  --border: var(--popup-border);
  --border-soft: var(--popup-border-soft);
  --glass-card: var(--popup-surface);
  --glass-soft: var(--popup-surface-2);
  --glass-seg-on: var(--popup-surface-3);
  --glass-edge: var(--popup-border-soft);
  border: 1rpx solid var(--border);
  border-radius: var(--r-xl);
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.36);
  /* 收起姿态：略小 + 略低，展开时回到原位（位移很小，只是让「弹出来」有形） */
  transform: scale(0.94) translateY(16rpx);
  transition: transform 0.24s cubic-bezier(0.32, 0.72, 0, 1);
}

.mask--on .modal {
  transform: none;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 10rpx;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -10rpx;
}

/*
 * 面板主体：和 .sheet-body 同一条规矩 —— **scroll-view** + flex 收缩 + min-height: 0。
 * 理由见上面 .sheet-body 那六版血泪史，这里不重复；简单说就是普通 view 的
 * overflow 滚动会被遮罩的 catchtouchmove 吃掉，真机上滑不动。
 * max-height 是兜底：flex 分配万一没认，scroll-view 也得有个确定的顶。
 */
.modal-body {
  padding: 6rpx 28rpx 0;
  flex: 1;
  min-height: 0;
  max-height: 60vh;
}

.modal-foot {
  padding: 20rpx 28rpx 26rpx;
  flex-shrink: 0;
}

/*
 * 弹层就是这里覆写一整套底色变量的地方，**故意不和卡片共用 --surface**。
 *
 * 卡片那几层要跟着 surfaceAlpha 变透明 —— 那是自定义主题里「让背景图透上来」的
 * 唯一途径。弹层跟着一起透就纯粹是坏事：它底下垫着一层 60% 黑的遮罩，
 * 页面本来就一点看不见，透出来的只有那块黑；同一个 sA 落在弹层上，
 * 效果是**面板越透越暗**，上面的正文和表单一起糊。滑块是拿来调卡片的，
 * 不该顺手把弹层里的字也调没。
 *
 * 覆写这一套而不是只改 background：弹层内侧的块用的还是 --surface-2 /
 * --surface-3，不跟着实心的话，它们和面板本身同处一个 sA，叠在同一个背板上
 * 差值会被 sA 直接压掉 —— 面板里的分区糊成一片，看不出块。
 * 弹层的后代全都吃这一套，所以只要写在这一个选择器上。
 *
 * 三套主题里这五个变量的兜底值见上面的 page { }；自定义主题下由
 * utils/theme.js 的 buildCustom 算出实心版本。
 */
.sheet {
  background: var(--glass-sheet);
  --surface: var(--popup-surface);
  --surface-2: var(--popup-surface-2);
  --surface-3: var(--popup-surface-3);
  --border: var(--popup-border);
  --border-soft: var(--popup-border-soft);
  /* 玻璃那三个别名跟着一起重绑。自定义属性是**在哪一层声明就在哪一层算死**的别名
     （--glass-card 在 page 上就解析成了 var(--surface) 的结果），不重绑的话，
     弹层里的 .card / .chip 会拿 page 那份**半透明**的卡片色，而不是这里实心的 popup 色 */
  --glass-card: var(--popup-surface);
  --glass-soft: var(--popup-surface-2);
  --glass-seg-on: var(--popup-surface-3);
  --glass-edge: var(--popup-border-soft);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  border-top: 1rpx solid var(--border);
  transform: translateY(100%);
  transition: transform 0.26s cubic-bezier(0.32, 0.72, 0, 1);
  /* 弹层最多占屏幕的 68%：这是底部弹出层的体量，再高就成了「全屏页」，
     背景完全看不见，用户也失去了「这只是盖在上面的一层」的感觉。
     同时它保证了主体一定溢出 —— 溢出才需要滚，见 .sheet-body 的说明。 */
  max-height: 68vh;
  display: flex;
  flex-direction: column;
  /* 内容再长也不许溢出：一旦溢出，超出 max-height 的部分会被裁掉，
     连 .sheet-head（现在挂着确认按钮）都可能被挤出可视区 */
  overflow: hidden;
}

.mask--on .sheet {
  transform: translateY(-30px);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx 16rpx;
  flex-shrink: 0;
  /* .sheet-acts 的定位基准 */
  position: relative;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.sheet-close {
  width: 60rpx;
  height: 60rpx;
  margin-right: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/*
 * 头部右侧的悬浮操作区：绝对定位浮在「×」左边。
 *
 * 为什么不像 .sheet-foot 那样留在文档流里：底部按钮的可见性取决于
 * 「主体有没有把空间让出来」——那是一整条 flex 链的博弈（见 .sheet-body 的注释，
 * 这儿已经翻过三次车）。把确认按钮挪到头部，它就变成了 .sheet 的**固定开销之外**
 * 的东西：头部本来就 flex-shrink: 0，按钮挂在它身上，主体再怎么长也顶不掉它。
 * 「确认按钮不显示」这一类故障直接失去发生的物理条件，而不用再去证明 flex 算对了。
 *
 * top: 0; bottom: 0 而不是写死 top 值：让它和 .sheet-close 一样受父级
 * align-items: center 摆布，垂直居中的结果天然一致。写死 top 的话，
 * 两个弹层头部内容高度不同（habit-editor 76rpx / checkin-sheet 有副标题），
 * 会各偏一点，且以后改 padding 还得跟着改。
 *
 * right: 96rpx = 头部 padding 28rpx + × 宽 60rpx + 间距 8rpx。
 */
.sheet-acts {
  position: absolute;
  right: 96rpx;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* 盖在标题上，长标题被截断而不是把按钮挤走 */
  z-index: 2;
}

/* 头部里的胶囊按钮：比 .btn 矮一圈，免得把 .sheet-head 撑高 */
.sheet-ok {
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  background: var(--accent);
  color: #FFFFFF;
  transition: opacity 0.15s ease;
}

.sheet-ok:active {
  opacity: 0.75;
}

/* 次要操作（取消修改）：不抢主按钮的视觉重量 */
.sheet-ok--ghost {
  background: var(--surface-3);
  color: var(--text-2);
  padding: 0 22rpx;
}

.sheet-ok--danger {
  background: var(--danger-soft);
  color: var(--danger);
  padding: 0 22rpx;
}

/*
 * 标题的右侧避让：给 .sheet-acts 让出位置，否则长标题会从胶囊按钮底下穿过去。
 *
 * 注意避让做在**左侧那块内容**上（margin-right），不是 .sheet-head 的 padding-right：
 * padding 会同时把右边的 × 一起推走，而 × 是靠 space-between 贴右的，
 * 一推就和悬浮按钮错位。加在左侧子项的 margin 上，× 不动，只有标题被挤窄 ——
 * 两个子项都有 .ellipsis（overflow: hidden）+ min-width: 0，挤窄即截断。
 *
 * 260rpx ≈ 「删除」(96rpx) + gap 12rpx + 「保存」(104rpx) + 余量。
 */
.sheet-head--acts > .sheet-title,
.sheet-head--acts > .ci-habit {
  margin-right: 260rpx;
}

/*
 * 弹层主体：**scroll-view**，靠 flex 收缩，不手算高度。
 *
 * 这里踩过四次坑，四版做法都记录在案，别再走回头路：
 *
 * ① `scroll-view` + `flex: 1`（第一版）
 *    主体没有收缩，被内容撑高。内容一旦超过 .sheet 的 max-height，
 *    overflow:hidden 就把下面的 .sheet-foot（当时的确认按钮）整块裁掉 ——
 *    「表单都在，就是没有确认按钮」。真正的病根是少了 min-height: 0
 *    （flex 项的 min-height 默认是 auto，撑起来就缩不回去），当时误判成了
 *    「scroll-view 不参与 flex 收缩」，连滚动的能力一起扔掉了。
 *
 * ② 外面套一层 view 用 flex 收缩 + scroll-view 绝对定位（第二版）
 *    那层 wrap 的 flex:1 在微信里塌成 0 高，scroll-view 跟着 0 高，
 *    整个弹层只剩标题，内容全没了，比 ① 更糟。
 *
 * ③ `scroll-view` + `height: calc(78vh - 240rpx)`（第三版）
 *    把一个弹层的可见性吊在**一条声明**上。calc() 里混用 vh 和 rpx，
 *    正是各基础库解析行为不一致的地方；只要这条被丢掉，scroll-view 就退回
 *    没有高度的状态 —— 直接回到故障 ①。量出来是好的（scripts/check-sheet.js
 *    在浏览器里量过），真机上却复发，因为「浏览器认得这条声明」和
 *    「微信认得这条声明」是两件事。
 *
 * ④ 普通 view + `overflow-y: auto`（第四版）
 *    在浏览器里能滚，**真机上不滚**。overflow 滚动的实现挂在 WebView 的
 *    touchmove 上，而遮罩为了防穿透正好 catch 住了 touchmove（见 .mask）。
 *    手指在弹层上拖，弹层纹丝不动，滚的却是背后那一屏 —— 这就是
 *    「弹出后滑不动，滑的是背景主页」。
 *
 * 第五版（当前）：回到 scroll-view，并且补上 ① 缺的那句 min-height: 0。
 * 两件事各归各位：
 *   - scroll-view 的滚动由客户端原生接管，触摸事件在它内部就被消费，
 *     不冒泡到遮罩，也就不会被 catchtouchmove 吃掉；
 *   - min-height: 0 让 flex: 1 算得出真正的可用高度，主体再长也撑不破弹层。
 *
 * 「确认按钮被顶出可视区」那类故障现在连发生的物理条件都没有了：
 * 按钮在 .sheet-head 里（flex-shrink: 0），主体怎么长都够不着它。
 * 剩下的只有「主体要能滚」这一件事，而这件事只有 scroll-view 做得到。
 *
 * 依然没有任何手算的高度，没有可以算错、可以被解析器丢掉的东西。
 *
 * 第六版补充：主体加了一条 `max-height` 兜底。
 * 起因是「创建习惯的弹层划不动」。排查下来最可能的情况是主体**几乎正好装得下** ——
 * 内容比可视区只高出几十 rpx，滚动行程短到看不出来，看着就像不能滚。
 * 把 .sheet 的上限从 88vh 收到 68vh（见上），主体必定溢出，滚动才有意义。
 *
 * max-height 那一句守的是另一件事：scroll-view 要能滚，前提是它有一个**确定的高度**。
 * flex: 1 算出来的高度在微信里通常认，但赌不起 —— 万一没认，scroll-view 就是
 * content 高，永远不滚。给它一条自己的上限，即使 flex 分配失效，盒子高度也有个确定的顶。
 * 两条同时生效也不会打架：装了 flex 就以 flex 为准，max-height 只在内容真的超出时才碰得到。
 */
.sheet-body {
  padding: 0 28rpx;
  flex: 1;
  min-height: 0;
  /* 兜底高度，必须小于 .sheet 的上限：差值留给 .sheet-head 和 .sheet-safe。
     真机上头部比这个差值高也没关系，flex-shrink 会接着往下压，
     压出来的仍然是确定高度 —— 这条只是保证「不会是 content 高」。 */
  max-height: 60vh;
}

.sheet-foot {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx 12rpx;
  border-top: 1rpx solid var(--border-soft);
  flex-shrink: 0;
}

.sheet-del {
  width: 180rpx;
  flex-shrink: 0;
}

.sheet-safe {
  height: 0;
  height: env(safe-area-inset-bottom);
  flex-shrink: 0;
}

.sheet-gap {
  height: 30rpx;
}

/* ============ 表单控件（弹层内共用） ============ */
.field {
  margin-bottom: 30rpx;
}

.field-row {
  display: flex;
  gap: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
}

.field-hint {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 10rpx;
}

.field-input {
  height: 88rpx;
  /* 输入框是「嵌进去」的：凹陷感走 --glass-inset，和卡片的方向相反。
     描边仍是 --border，不换成玻璃边 —— 换了自定义主题的描边色就跟着变了 */
  background: var(--glass-soft);
  border: 1rpx solid var(--border);
  box-shadow: var(--glass-inset);
  border-radius: var(--r-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text);
}

.field-input--mt {
  margin-top: 16rpx;
}

.field-input--error {
  border-color: var(--danger);
}

.field-error {
  font-size: 22rpx;
  color: var(--danger);
  margin-top: 10rpx;
}

.ph {
  color: var(--text-3);
  font-size: 26rpx;
}
