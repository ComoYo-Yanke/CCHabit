/* 导航栏右侧操作按钮 */
.nav-action {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-action-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ============ 头部信息 ============ */
.hd-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hd-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-lg);
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  flex-shrink: 0;
}

.hd-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
}

.hd-sub {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

.hd-stats {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  background: var(--inset-bg);
  border-radius: var(--r-md);
  padding: 22rpx 0;
}

.hd-stat {
  flex: 1;
  text-align: center;
}

.hd-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}

.hd-stat-label {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.hd-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--border);
}

.hd-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.hd-edit {
  width: 180rpx;
  flex-shrink: 0;
}

/*
 * 「定时任务」按钮：在 .hd-top 那一行的末尾 —— 也就是标题右侧、
 * 卡片底部「编辑」的上方。
 *
 * 不写成 .btn--ghost 的默认体量：那一行还站着 96rpx 的图标和两行标题，
 * 按钮按 .btn 的高度（88rpx）会把 .hd-top 撑高一小截。压到 60rpx 让它
 * 和标题块齐平，视觉上只占一行。
 */
.hd-task {
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  font-size: 23rpx;
}

/* 已排了几个定时任务的小角标；没排时不渲染（wx:if），所以不用管 0 的情况 */
.hd-task-num {
  margin-left: 8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  background: var(--accent);
  color: #FFFFFF;
}

/* ============ 日历 ============ */
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.cal-nav {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-nav-icon {
  width: 32rpx;
  height: 32rpx;
}

.cal-nav--off {
  opacity: 0.3;
}

.cal-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.cal-weekdays {
  display: flex;
  margin-bottom: 10rpx;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 21rpx;
  color: var(--text-3);
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.285%;
  height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: var(--r-sm);
}

.cal-cell--empty {
  visibility: hidden;
}

.cal-day {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1;
}

.cal-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-top: 8rpx;
}

/* 今天：加一圈描边 */
.cal-cell--today {
  border: 2rpx solid var(--accent);
}

/* 未来的日子：压暗一档即可，别用 surface 系列 —— 那组颜色是「底色」，
   浅色主题下 --surface-3 是接近纯白的 #E5E7EB，写在白卡片上等于把日期擦掉了 */
.cal-cell--future .cal-day {
  color: var(--text-3);
  opacity: 0.55;
}

/* 正常情况下未来的格子不会有记录，留着兜住导入进来的脏数据 */
.cal-cell--future .cal-dot {
  opacity: 0.3;
}

/* ============ 区间导航 ============ */
.range-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0;
}

.range-label {
  font-size: 27rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}

.range-tiles {
  gap: 14rpx;
}

.range-tiles .tile {
  padding: 20rpx 10rpx;
}

.range-tiles .tile-value {
  font-size: 36rpx;
}

.range-extra {
  margin-top: 20rpx;
}

.range-extra-row {
  margin-top: 16rpx;
}

/* ============ 图表 ============ */
.chart-card {
  padding: 16rpx 4rpx 8rpx;
}

/* ============ 历史记录 ============ */
.hist {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--border-soft);
  border-radius: var(--r-md);
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}

.hist-date {
  width: 180rpx;
  flex-shrink: 0;
}

.hist-date-main {
  font-size: 27rpx;
  color: var(--text);
  font-weight: 500;
}

.hist-date-sub {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.hist-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  min-width: 110rpx;
}

.hist-value-num {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.hist-value-unit {
  font-size: 21rpx;
  color: var(--text-3);
}

.hist-note {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
}

.load-more {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--accent);
  background: var(--surface);
  border-radius: var(--r-md);
  border: 1rpx solid var(--border-soft);
}

.list-end {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 30rpx 0 10rpx;
}

.list-bottom-gap {
  height: 60rpx;
}
