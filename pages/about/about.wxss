/* 关于页：全部复用全局卡片与文本类，这里只补本页独有的排版 */

/* ============ 应用标识 ============ */
.app-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 56rpx 28rpx 48rpx;
  background: linear-gradient(160deg, #1B2334 0%, #171B24 62%);
}

.app-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: var(--accent-soft);
  border: 2rpx solid rgba(91, 140, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.app-logo-icon {
  width: 68rpx;
  height: 68rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 26rpx;
}

.app-ver {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

.app-slogan {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 20rpx;
  line-height: 1.6;
}

/* ============ 键值行 ============ */
.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.kv:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.kv:first-child {
  padding-top: 0;
}

.kv-k {
  font-size: 28rpx;
  color: var(--text-2);
}

.kv-v {
  font-size: 28rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

/* ============ 功能列表 ============ */
.feat {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.feat:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.feat:first-child {
  padding-top: 0;
}

.feat-icon {
  font-size: 40rpx;
  line-height: 1.3;
}

.feat-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}

.feat-desc {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ============ 隐私说明 ============ */
.privacy-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.privacy-row:last-child {
  margin-bottom: 0;
}

.privacy-icon {
  width: 34rpx;
  height: 34rpx;
  margin-top: 4rpx;
}

.privacy-text {
  flex: 1;
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.65;
}

/* ============ 开发者 ============ */
.dev-top {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.dev-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent) 0%, #7FB2FF 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dev-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.dev-role {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.dev-intro {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.75;
  margin-top: 26rpx;
}

.dev-mail {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
}

.dev-mail-icon {
  width: 34rpx;
  height: 34rpx;
}

.dev-mail-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}

.dev-mail-copy {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

/* ============ 说明文字与版权 ============ */
.about-desc {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.7;
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.copyright {
  text-align: center;
  padding: 56rpx 28rpx 0;
}

.copyright-line {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.9;
}

/* 列表底部留白（各页面各自定义，不是全局类） */
.list-bottom-gap {
  height: 40rpx;
}
