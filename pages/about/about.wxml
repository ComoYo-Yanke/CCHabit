<!--
  page-meta 必须是页面的第一个节点。
  换肤就靠它：把当前主题的 CSS 变量写成 page 的行内样式（见 utils/theme.js）。
-->
<page-meta page-style="{{themeStyle}}"></page-meta>

<nav-bar title="关于" back="{{true}}" fixed="{{true}}" />

<view class="page page--no-tabbar page--fade {{fading ? 'page--out' : ''}}">
  <!-- 自定义主题的背景图那一层（没有设置背景图时它自己不渲染），见 components/app-bg -->
  <app-bg theme-name="{{themeName}}" />

  <!-- 名言：本页顶上是 nav-bar，没有可以安放它的头部，所以单独占一行横条
       （样式见 app.wxss 的 .quote-line）。文本来自 utils/quotes.js -->
  <view class="quote-line ellipsis">{{quote.text}} · {{quote.author}}</view>

  <!-- ============ 应用标识 ============ -->
  <view class="section">
    <view class="app-hero card">
      <view class="app-logo">
        <view class="ic ic-check-active app-logo-icon"></view>
      </view>
      <view class="app-name">习惯打卡</view>
      <view class="app-ver">版本 {{version}}</view>
      <view class="app-slogan">记录每一次坚持，看见自己的变化</view>
    </view>
  </view>

  <!-- ============ 小程序信息 ============ -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">小程序信息</text>
    </view>
    <view class="card">
      <view class="kv">
        <text class="kv-k">名称</text>
        <text class="kv-v">习惯打卡</text>
      </view>
      <view class="kv">
        <text class="kv-k">版本</text>
        <text class="kv-v">v{{version}}</text>
      </view>
      <view class="kv">
        <text class="kv-k">形态</text>
        <text class="kv-v">原生微信小程序</text>
      </view>
      <view class="kv">
        <text class="kv-k">联网</text>
        <text class="kv-v t-success">完全不联网</text>
      </view>
    </view>
    <view class="about-desc">
      用原生小程序（WXML / WXSS / JS）实现，图表由 uCharts 绘制。
    </view>
  </view>

  <!-- ============ 开屏设置 ============
       开关本身是原生组件，拿不到 CSS 变量，主色只能从 JS 给（见 about.js 的 accent） -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">开屏设置</text>
    </view>
    <view class="card" style="padding: 8rpx 28rpx;">
      <view class="sw-item">
        <view class="flex-1">
          <view class="sw-title">此次更新不再显示公告</view>
          <view class="sw-desc">和开屏弹窗里那个勾选框是同一件事，勾了就打开；只作用于当前版本，下次更新还会提示</view>
        </view>
        <switch
          checked="{{updateMuted}}"
          color="{{accent}}"
          bindchange="onToggleUpdateNotice"
        />
      </view>
    </view>
  </view>

  <!-- ============ 主要功能 ============ -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">主要功能</text>
    </view>
    <view class="card">
      <view class="feat" wx:for="{{features}}" wx:key="title">
        <text class="feat-icon">{{item.icon}}</text>
        <view class="flex-1">
          <view class="feat-title">{{item.title}}</view>
          <view class="feat-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 最近更新 ============ -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">最近更新</text>
      <text class="section-sub">当前 v{{version}}</text>
    </view>
    <view class="card">
      <view class="log" wx:for="{{changelog}}" wx:key="version">
        <view class="log-head">
          <text class="log-ver">v{{item.version}}</text>
          <text class="log-date">{{item.date}}</text>
        </view>
        <view class="log-item" wx:for="{{item.items}}" wx:for-item="line" wx:key="*this">
          <text class="log-dot">·</text>
          <text class="log-text">{{line}}</text>
        </view>
      </view>

      <!--
        更早的版本不在本页铺开（这一栏叫「最近更新」，铺满就没人看），
        而是跳进「版本记录」页看全部 —— 那边一屏铺开整份日志，
        底部还留着「GitHub 查看详情」的复制入口。
      -->
      <view wx:if="{{hasMoreLog}}" class="log-more press" bindtap="onMoreLog">
        <text class="log-more-text">更早的版本记录</text>
        <text class="log-more-go">全部版本 ›</text>
      </view>
    </view>
  </view>

  <!-- ============ 数据与隐私 ============ -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">数据与隐私</text>
    </view>
    <view class="card">
      <view class="privacy-row">
        <view class="ic ic-check-active privacy-icon"></view>
        <text class="privacy-text">无服务端、无账号、不联网，所有打卡数据只保存在你手机的微信小程序存储中</text>
      </view>
      <view class="privacy-row">
        <view class="ic ic-check-active privacy-icon"></view>
        <text class="privacy-text">不会上传、不会分享，开发者也无法看到你的任何记录</text>
      </view>
      <view class="privacy-row">
        <view class="ic ic-fire-active privacy-icon"></view>
        <text class="privacy-text">卸载小程序或清理微信缓存会清空数据，建议定期在「我的 - 存储管理」导出备份</text>
      </view>
    </view>
  </view>

  <!-- ============ 开发者 ============ -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">开发者</text>
    </view>
    <view class="card">
      <view class="dev-top">
        <view class="dev-avatar">CY</view>
        <view class="flex-1">
          <view class="dev-name">{{developer.name}}</view>
          <view class="dev-role">独立开发者</view>
        </view>
      </view>

      <view class="dev-intro">{{developer.intro}}</view>

      <view class="dev-mail press" bindtap="onCopyEmail">
        <view class="ic ic-mail-idle dev-mail-icon"></view>
        <text class="dev-mail-text">{{developer.email}}</text>
        <text class="dev-mail-copy">复制</text>
      </view>
      <!--
        GitHub 快捷方式。
        小程序不能直接打开外部链接（web-view 只认业务域名，个人开发者一般没有），
        所以这里做的是「复制地址」：点了复制到剪贴板，用户自己粘到浏览器。
      -->
      <view class="dev-mail press" bindtap="onCopyGithub">
        <view class="ic ic-github-idle dev-mail-icon"></view>
        <text class="dev-mail-text">github.com/ComoYo-Yanke/CCHabit</text>
        <text class="dev-mail-copy">复制</text>
      </view>
    </view>
    <view class="about-desc">
      使用中遇到问题、或有想加的功能，欢迎邮件告诉我，也欢迎来 GitHub 提 issue。
    </view>
  </view>

  <!-- ============ 版权 ============ -->
  <view class="copyright">
    <view class="copyright-line">习惯打卡 v{{version}}</view>
    <view class="copyright-line">© 2026 {{developer.name}}</view>
    <!--
      备案号。要求是指向工信部官网，但小程序打不开外链，所以做成了「点击复制地址」，
      提示语会告诉用户粘到浏览器打开（见 about.js 的 onCopyBeian）。
      视觉上按链接处理：主色 + 下划线，点得出来是个能点的东西。
    -->
    <view class="copyright-line">
      <text class="beian press" bindtap="onCopyBeian">{{beian}}</text>
    </view>
  </view>

  <view class="list-bottom-gap"></view>
</view>
