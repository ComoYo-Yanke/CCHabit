/* 顶部问候：用渐变把页面顶部和内容区分开 */
.hero {
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 8rpx;
  /* 顶部光晕的整段值来自主题：浅色下要换成白色微光，写死就会是一条深色带 */
  background: var(--grad-top);
}

.hero-date {
  font-size: 26rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 10rpx;
  line-height: 1.3;
}

/* 今日概览 */
.overview {
  background: linear-gradient(135deg, var(--grad-card-from) 0%, var(--grad-card-to) 60%);
}

.ov-label {
  font-size: 24rpx;
  color: var(--text-3);
}

.ov-num {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 10rpx;
}

.ov-num-main {
  font-size: 68rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.ov-num-total {
  font-size: 30rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.ov-streak {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--warn-soft);
  border-radius: var(--r-md);
  padding: 16rpx 24rpx;
}

.ov-fire {
  width: 44rpx;
  height: 44rpx;
}

.ov-streak-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--warn);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.ov-streak-label {
  font-size: 20rpx;
  color: var(--warn);
  opacity: 0.8;
}

.ov-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--surface-3);
  overflow: hidden;
  margin-top: 28rpx;
}

.ov-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--accent) 0%, var(--success) 100%);
  transition: width 0.35s ease;
}

.ov-foot {
  margin-top: 16rpx;
}

.ov-go {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.ov-go-done {
  font-size: 24rpx;
  color: var(--success);
}

/* 悬浮新建按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  /* 兜底值必须写：env() 参与 calc 若解析失败，bottom 会被整条丢掉，
     悬浮按钮就会退回 static 位置（在长页面里等于跑到屏幕外，点不到）。
     这正是「怎么都加不了习惯」的典型成因。 */
  bottom: 146rpx;
  bottom: calc(146rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 890;
  box-shadow: 0 12rpx 32rpx rgba(91, 140, 255, 0.4);
  /* 两个过渡写在一起：opacity 跟着页面淡入（去掉 .fab--out 那一下），
     transform 是按压反馈。分开写会互相覆盖 */
  transition: opacity 0.26s cubic-bezier(0.42, 0, 0.58, 1), transform 0.15s ease;
}

/* 切换时跟着页面一起淡出（机制见 utils/page-fade.js）。
   不复用 .page--out：上面 .fab 自己的 transition 还管着 transform（按压反馈），
   两个 transition 简写会互相覆盖，所以这里把两条都写全。 */
.fab--out {
  opacity: 0;
  transition: opacity 0.14s ease-in, transform 0.15s ease;
}

.fab:active {
  transform: scale(0.92);
}

.fab-icon {
  width: 52rpx;
  height: 52rpx;
}

.list-bottom-gap {
  height: 40rpx;
}
