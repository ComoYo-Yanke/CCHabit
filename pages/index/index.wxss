/* 顶部问候：用渐变把页面顶部和内容区分开 */
.hero {
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 8rpx;
  /* 顶部光晕的整段值来自主题：浅色下要换成白色微光，写死就会是一条深色带 */
  background: var(--grad-top);
}

.hero-date {
  font-size: 26rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 10rpx;
  line-height: 1.3;
}

/* 今日概览 */
.overview {
  background: linear-gradient(135deg, var(--grad-card-from) 0%, var(--grad-card-to) 60%);
}

.ov-label {
  font-size: 24rpx;
  color: var(--text-3);
}

.ov-num {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 10rpx;
}

.ov-num-main {
  font-size: 68rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.ov-num-total {
  font-size: 30rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.ov-streak {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--warn-soft);
  border-radius: var(--r-md);
  padding: 16rpx 24rpx;
}

.ov-fire {
  width: 44rpx;
  height: 44rpx;
}

.ov-streak-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--warn);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.ov-streak-label {
  font-size: 20rpx;
  color: var(--warn);
  opacity: 0.8;
}

.ov-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--surface-3);
  overflow: hidden;
  margin-top: 28rpx;
}

.ov-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--accent) 0%, var(--success) 100%);
  transition: width 0.35s ease;
}

.ov-foot {
  margin-top: 16rpx;
}

.ov-go {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.ov-go-done {
  font-size: 24rpx;
  color: var(--success);
}

/* 新建习惯的圆钮不在本页了，挪进了底部胶囊「主页」左边（见 custom-tab-bar）：
   它本来就不该是个「贴在这个页面上的东西」——创建习惯是全应用的动作，
   不是首页的动作，而且现在这个位置正好在拇指够得着的胶囊里。
   所以 .fab / .fab--out / .fab:active / .fab-icon 四条连同浮层的 z-index 一起删掉了，
   那套「跟着页面淡入淡出」的补丁也一并不需要了。 */

/* 习惯卡片的两列栅格。
   列宽必须减去 gap 再对半分：50% 是「容器的一半」，两列各占一半之后
   中间还有 20rpx 的缝，加起来超过 100%，第二列会被挤到下一行。
   卡片的高度由它自己的 padding-bottom: 100% 跟着这个宽度算出来（见 habit-card 的 .hc） */
.habit-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.habit-cell {
  width: calc((100% - 20rpx) / 2);
}

/* ---------- 更新提示弹窗（面板本体在 app.wxss 的 .modal） ---------- */
.upd-label {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 14rpx;
}

.upd-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

/* 小圆点当项目符号：比「·」对齐得准，也不用管字体 */
.upd-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
  /* 和首行文字视觉居中（文字 26rpx、行高 1.7 → 首行约 44rpx） */
  margin-top: 17rpx;
}

.upd-item-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-2);
}

/* 正文只垫一点点底：下面紧跟着尾部按钮，垫多了面板中间会空出一块 */
.upd-body {
  padding-bottom: 6rpx;
}

/* 「此次更新不再显示」那一行。做成整行可点：22rpx 的小方格在手机上不好按，
   而这一行本来就是个「要不要」的选项，点哪儿都该算数 */
.upd-mute {
  display: flex;
  align-items: center;
  gap: 14rpx;
  /* 和下面的按钮分开一点，免得误点到「知道了」上（那一下是「接受」，语义相反） */
  margin-bottom: 22rpx;
}

.upd-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 9rpx;
  /* 没勾：一个空心方框。用 inset 阴影画描边，不占内容盒，
     勾上之后底色铺满时不会因为边框而小一圈 */
  box-shadow: inset 0 0 0 2rpx var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: box-shadow 0.15s ease;
}

.upd-check--on {
  background: var(--accent);
  box-shadow: inset 0 0 0 2rpx var(--accent);
}

.upd-check-icon {
  width: 24rpx;
  height: 24rpx;
}

.upd-mute-text {
  font-size: 24rpx;
  color: var(--text-3);
}

.list-bottom-gap {
  height: 40rpx;
}
