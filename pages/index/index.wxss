/* 顶部问候：用渐变把页面顶部和内容区分开 */
.hero {
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 8rpx;
  /* 顶部光晕的整段值来自主题：浅色下要换成白色微光，写死就会是一条深色带 */
  background: var(--grad-top);
}

/*
 * 当前日期。原来是全页最淡的一级色（--text-3），压在头部那层渐变光晕上，
 * 自定义主题下经常就是「看得见但读不清」。
 * 现在三件事一起做，把对比度拉到最高，但仍然只占文字那一小块：
 *   1. 文字用最亮的一级 --text；
 *   2. 身后垫一层**反色**底 —— 用页面底色 --bg，它和 --text 正好是色阶的两端，
 *      这一对付色组合在这一页里对比度最高；
 *   3. 一圈主色柔光：深底上是发光，浅底上是柔和的光晕，两种底色都成立。
 * 胶囊形状（inline-block + 圆角 + 自身内边距）是为了不把它拉成一条横贯头部的色带 ——
 * 「不影响整体」的关键就在这，垫底只跟着文字走。
 */
.hero-date {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: var(--text);
  background: var(--bg);
  box-shadow: 0 0 0 1rpx var(--border-soft);
  text-shadow: 0 0 12rpx var(--accent-soft), 0 0 26rpx var(--accent-soft);
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 10rpx;
  line-height: 1.3;
}

/* 开屏鼓励语。刻意压到 22rpx、用最淡的一级色，且只占一行（.ellipsis 截断）——
   它是问候语下面的配角，绝不能把头部撑高或把视线从「今日完成」上抢走。
   用 --text-3 而不是 --text-2：这里读不清无所谓，那是说明文字才该有的对比度 */
.hero-quote {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-3);
}

/* 今日概览 */
.overview {
  background: linear-gradient(135deg, var(--grad-card-from) 0%, var(--grad-card-to) 60%);
}

.ov-label {
  font-size: 24rpx;
  color: var(--text-3);
}

.ov-num {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 10rpx;
}

.ov-num-main {
  font-size: 68rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.ov-num-total {
  font-size: 30rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.ov-streak {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--warn-soft);
  border-radius: var(--r-md);
  padding: 16rpx 24rpx;
}

.ov-fire {
  width: 44rpx;
  height: 44rpx;
}

.ov-streak-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--warn);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.ov-streak-label {
  font-size: 20rpx;
  color: var(--warn);
  opacity: 0.8;
}

.ov-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--surface-3);
  overflow: hidden;
  margin-top: 28rpx;
}

.ov-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--accent) 0%, var(--success) 100%);
  transition: width 0.35s ease;
}

.ov-foot {
  margin-top: 16rpx;
}

.ov-go {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

.ov-go-done {
  font-size: 24rpx;
  color: var(--success);
}

/* 新建习惯的圆钮不在本页了，挪进了底部胶囊「主页」左边（见 custom-tab-bar）：
   它本来就不该是个「贴在这个页面上的东西」——创建习惯是全应用的动作，
   不是首页的动作，而且现在这个位置正好在拇指够得着的胶囊里。
   所以 .fab / .fab--out / .fab:active / .fab-icon 四条连同浮层的 z-index 一起删掉了，
   那套「跟着页面淡入淡出」的补丁也一并不需要了。 */

/* 习惯卡片的两列栅格。
   列宽必须减去 gap 再对半分：50% 是「容器的一半」，两列各占一半之后
   中间还有 20rpx 的缝，加起来超过 100%，第二列会被挤到下一行。
   卡片的高度由它自己的 padding-bottom: 100% 跟着这个宽度算出来（见 habit-card 的 .hc） */
.habit-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.habit-cell {
  width: calc((100% - 20rpx) / 2);
}

/* ---------- 更新提示弹窗（面板本体在 app.wxss 的 .modal） ----------
   这一屏的**正文字号 = 最高对比**：颜色仍然跟着主题走（自定义主题下就是用户调的
   那两级文字色），但用色往上提一档 —— 原来正文用 --text-2、说明用 --text-3，
   自定义主题里这两级是「次要文字往底色退」推出来的，用户把两者的对比调得接近时，
   弹窗里这几行就成了「看得见但读不清」。弹窗是**要读的**，所以正文直接用 --text，
   说明文字提到 --text-2（而不是留给最淡的 --text-3）。

   光提色阶还不够：面板底色（--popup-surface）也是从用户给的颜色推的，
   用户把底色和文字色调得接近时，再高的色阶也拉不开。所以这一屏的字**统一描一圈边** ——
   用页面底色 --bg 做四个方向的 text-shadow，就是一圈 1rpx 的实边。
   挑 --bg 是因为它和文字色天然反色（色阶两端），深浅两套主题都不用另配一套色；
   描边只有 1rpx，动的是可读性，不动观感。 */
.upd-label,
.upd-item-text,
.upd-mute-text {
  text-shadow: -1rpx -1rpx 0 var(--bg), 1rpx -1rpx 0 var(--bg), -1rpx 1rpx 0 var(--bg),
    1rpx 1rpx 0 var(--bg);
}

.upd-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 14rpx;
}

.upd-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

/* 小圆点当项目符号：比「·」对齐得准，也不用管字体 */
.upd-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
  /* 和首行文字视觉居中（文字 26rpx、行高 1.7 → 首行约 44rpx） */
  margin-top: 17rpx;
}

.upd-item-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text);
}

/* 正文只垫一点点底：下面紧跟着尾部按钮，垫多了面板中间会空出一块 */
.upd-body {
  padding-bottom: 6rpx;
}

/* 「此次更新不再显示」那一行。做成整行可点：22rpx 的小方格在手机上不好按，
   而这一行本来就是个「要不要」的选项，点哪儿都该算数 */
.upd-mute {
  display: flex;
  align-items: center;
  gap: 14rpx;
  /* 和下面的按钮分开一点，免得误点到「知道了」上（那一下是「接受」，语义相反） */
  margin-bottom: 22rpx;
}

.upd-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 9rpx;
  /* 没勾：一个空心方框。用 inset 阴影画描边，不占内容盒，
     勾上之后底色铺满时不会因为边框而小一圈 */
  box-shadow: inset 0 0 0 2rpx var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: box-shadow 0.15s ease;
}

.upd-check--on {
  background: var(--accent);
  box-shadow: inset 0 0 0 2rpx var(--accent);
}

.upd-check-icon {
  width: 24rpx;
  height: 24rpx;
}

.upd-mute-text {
  font-size: 24rpx;
  color: var(--text-2);
}

.list-bottom-gap {
  height: 40rpx;
}
