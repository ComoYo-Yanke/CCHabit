<!--
  page-meta 必须是页面第一个节点。
  遮罩上的 catchtouchmove 只拦触摸事件；开发者工具里鼠标滚轮走 wheel 事件，
  它会直接滚到背后的主屏。这里在弹层打开期间关掉页面根节点的滚动，
  从源头掐断，滚轮和触摸都滚不动。详见 pages/habit-detail 顶部同样的注释。

  themeStyle 是当前主题的 CSS 变量，写成 page 的行内样式后覆盖 app.wxss 里的
  深色默认值，整页随之换肤（见 utils/theme.js）。page-style 是整体覆盖，
  所以弹层的 overflow 必须自己拼在后面。
-->
<page-meta page-style="{{themeStyle}}{{(showEditor || showCheckin || verMounted) ? 'overflow: hidden;' : ''}}"></page-meta>

<!--
  淡出淡入全靠 fading 这一个布尔量（机制见 utils/page-fade.js）：
  true = 本页必须是透明的，页面看起来是空的（首次进入还没渲染完、以及切走之后）。
  去掉 .page--out 是 0→1 的淡入，加上是 1→0 的淡出。
-->
<view class="page page--fade {{fading ? 'page--out' : ''}}">
  <!-- 自定义主题的背景图那一层（没有设置背景图时它自己不渲染），见 components/app-bg -->
  <app-bg theme-name="{{themeName}}" />

  <!-- ============ 顶部问候 ============ -->
  <view class="hero" style="padding-top: {{statusBarHeight + 20}}px;">
    <view class="hero-date">{{dateLabel}}</view>
    <view class="hero-title">{{greeting}}</view>
  </view>

  <!-- ============ 今日概览 ============ -->
  <view class="section">
    <view class="overview card">
      <view class="row-between">
        <view>
          <view class="ov-label">今日完成</view>
          <view class="ov-num">
            <text class="ov-num-main">{{todayDone}}</text>
            <text class="ov-num-total">/ {{todayTotal}}</text>
          </view>
        </view>
        <view class="ov-streak">
          <view class="ic ic-fire-active ov-fire"></view>
          <view>
            <view class="ov-streak-num">{{maxStreak}}</view>
            <view class="ov-streak-label">最长连续</view>
          </view>
        </view>
      </view>

      <view class="ov-bar">
        <view class="ov-bar-fill" style="width: {{todayPercent}}%;"></view>
      </view>

      <view class="row-between ov-foot">
        <text class="f-22 t-3">完成度 {{todayPercent}}%</text>
        <text wx:if="{{hasHabits && todayDone < todayTotal}}" class="ov-go" bindtap="onOpenOverviewCheckin">去打卡 ›</text>
        <text wx:elif="{{hasHabits}}" class="ov-go-done">今日全部完成 🎉</text>
      </view>
    </view>
  </view>

  <!-- ============ 空状态 ============ -->
  <block wx:if="{{!hasHabits}}">
    <empty-state
      icon="🌱"
      title="还没有习惯"
      desc="创建第一个打卡项，比如「背单词 50 个」或「喝水 2000 毫升」，每天点一下就完成记录。"
      action="创建习惯"
      subAction="载入示例数据"
      bind:action="onAddHabit"
      bind:subaction="onSeedDemo"
    />
  </block>

  <!-- ============ 合并热力总览 ============ -->
  <block wx:if="{{hasHabits}}">
    <view class="section">
      <view class="section-head">
        <text class="section-title">打卡总览</text>
        <text class="section-sub">共 {{overviewWeeks}} 周 · 左右滑动</text>
      </view>
      <view class="card">
        <!-- scroll：全部历史横向铺开，初始停在今天，向左拖看更早的记录 -->
        <heatmap
          dayMap="{{overviewMap}}"
          weeks="{{overviewWeeks}}"
          scroll="{{true}}"
          showMonths="{{true}}"
          showLegend="{{true}}"
        />
      </view>
    </view>

    <!-- ============ 习惯列表 ============ -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">我的习惯</text>
        <text class="section-sub">长按卡片可编辑</text>
      </view>

      <!-- 两列栅格：卡片做成正方形后自己不知道宽度，列宽（也就是卡片的宽和高）
           由这里给。用 gap + calc((100% - 20rpx) / 2) 而不是 50% —— 后者会把
           gap 算进两列里，第二列直接被挤到下一行，变成一列一个 -->
      <view class="habit-grid">
        <view wx:for="{{items}}" wx:key="habit.id" class="habit-cell">
          <habit-card
            item="{{item}}"
            weeks="{{cardWeeks}}"
            showHeat="{{true}}"
            bind:tapcard="onCardTap"
            bind:checkin="onCardCheckin"
            bind:longpress="onCardLongPress"
          />
        </view>
      </view>
    </view>
  </block>

  <view class="list-bottom-gap"></view>
</view>

<!-- ============ 悬浮新建按钮 ============ -->
<!-- 悬浮按钮是 .page 的**兄弟节点**（不是子节点），不会跟着 .page 的透明度走，
     所以自己挂一套等效的类，跟着页面一起淡出 / 淡入（见 index.wxss 的 .fab--out） -->
<view class="fab {{fading ? 'fab--out' : ''}}" bindtap="onAddHabit">
  <!-- 必须用白色加号：ic-plus-active 是蓝色描边，和按钮底色一样，会完全看不见 -->
  <view class="ic ic-plus-white fab-icon"></view>
</view>

<!--
  ============ 更新提示（首次打开新版本时弹一次） ============
  放在 .page 之外，理由和悬浮按钮一样：.page--out 是整棵子树透明度归零，
  提示弹在页面之外，不能跟着页面的淡入淡出一起被抹掉。
  内容只是文字（没有 input 之类的原生组件），但遮罩仍然照规矩两级挂载 ——
  .mask 收起时 display:none 是那套原生化问题的唯一正解，见 app.wxss 的 .mask。
-->
<view
  class="mask mask--center {{verMounted ? 'mask--mounted' : ''}} {{verOn ? 'mask--on' : ''}}"
  catchtouchmove="noop"
  bindtap="onCloseUpdate"
>
  <!-- 面板自己吞掉点击，点面板空白处不该关掉 -->
  <view class="modal" catchtap="noop">
    <view class="modal-head">
      <view class="modal-title">已更新至 v{{verVersion}}</view>
      <view class="modal-close press" bindtap="onCloseUpdate">
        <view class="ic ic-close-idle"></view>
      </view>
    </view>

    <scroll-view scroll-y class="modal-body upd-body">
      <view class="upd-label">本次更新</view>
      <view wx:for="{{verItems}}" wx:key="*this" class="upd-item">
        <view class="upd-dot"></view>
        <text class="upd-item-text">{{item}}</text>
      </view>
    </scroll-view>

    <view class="modal-foot">
      <view class="btn btn--primary" bindtap="onCloseUpdate">知道了</view>
    </view>
  </view>
</view>

<!-- ============ 弹层 ============ -->
<habit-editor
  show="{{showEditor}}"
  habit="{{editingHabit}}"
  bind:close="onCloseEditor"
  bind:submit="onSubmitHabit"
  bind:delete="onDeleteHabit"
/>

<checkin-sheet
  show="{{showCheckin}}"
  habit="{{checkinHabit}}"
  date="{{checkinDate}}"
  bind:close="onCloseCheckin"
  bind:change="onCheckinChange"
/>
