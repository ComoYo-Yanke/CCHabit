.hero {
  padding: 0 28rpx 8rpx;
  background: var(--grad-top);
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
}

.hero-date {
  font-size: 25rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}

.tiles-row {
  display: flex;
  gap: 16rpx;
}

.tiles-row .tile {
  padding: 26rpx 20rpx;
  text-align: center;
}

/* ============ 存储用量 ============ */
.usage-bar {
  height: 14rpx;
  border-radius: 7rpx;
  background: var(--surface-3);
  overflow: hidden;
}

.usage-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.35s ease;
}

.usage-fill--ok {
  background: var(--success);
}

.usage-fill--warn {
  background: var(--warn);
}

.usage-fill--danger {
  background: var(--danger);
}

.usage-meta {
  margin-top: 14rpx;
}

/* ============ 操作列表 ============ */
.op-list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--border-soft);
}

.op {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.op:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.op-icon {
  width: 44rpx;
  height: 44rpx;
}

.op-title {
  font-size: 28rpx;
  color: var(--text);
}

.op-desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.op-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

/* ============ 习惯管理 ============ */
.mg-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.mg-item:last-child {
  border-bottom: none;
}

.mg-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.mg-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--r-sm);
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.mg-name {
  font-size: 28rpx;
  color: var(--text);
}

.mg-name--off {
  color: var(--text-3);
}

.mg-desc {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.mg-add {
  margin-top: 20rpx;
}

/* ============ 偏好开关 ============ */
.sw-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.sw-item--last {
  border-bottom: none;
}

.sw-title {
  font-size: 28rpx;
  color: var(--text);
}

.sw-desc {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

/* ============ 关于 ============ */
.about-desc {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.7;
  margin-top: 16rpx;
}

/* ============ 导入弹层 ============ */
.import-area {
  width: 100%;
  height: 340rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  padding: 20rpx 22rpx;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.6;
}

.list-bottom-gap {
  height: 40rpx;
}
