.hero {
  padding: 0 28rpx 8rpx;
  background: var(--grad-top);
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
}

.hero-date {
  font-size: 25rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}

/* 开屏鼓励语。刻意压到 22rpx、用最淡的一级色，且只占一行（.ellipsis 截断）——
   它是头部里的配角，不能撑高头部、也不能抢走下面数据概览的视线 */
.hero-quote {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-3);
}

.tiles-row {
  display: flex;
  gap: 16rpx;
}

.tiles-row .tile {
  padding: 26rpx 20rpx;
  text-align: center;
}

/* ============ 存储用量 ============ */
.usage-bar {
  height: 14rpx;
  border-radius: 7rpx;
  background: var(--surface-3);
  overflow: hidden;
}

.usage-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.35s ease;
}

.usage-fill--ok {
  background: var(--success);
}

.usage-fill--warn {
  background: var(--warn);
}

.usage-fill--danger {
  background: var(--danger);
}

.usage-meta {
  margin-top: 14rpx;
}

/* ============ 操作列表 ============ */
.op-list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--border-soft);
}

.op {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.op:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.op-icon {
  width: 44rpx;
  height: 44rpx;
}

.op-title {
  font-size: 28rpx;
  color: var(--text);
}

.op-desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}


/* ============ 习惯管理 ============ */
.mg-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.mg-item:last-child {
  border-bottom: none;
}

.mg-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.mg-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--r-sm);
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.mg-name {
  font-size: 28rpx;
  color: var(--text);
}

.mg-name--off {
  color: var(--text-3);
}

.mg-desc {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.mg-add {
  margin-top: 20rpx;
}

/* ============ 偏好开关 ============ */
.sw-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-soft);
}

.sw-item--last {
  border-bottom: none;
}

.sw-title {
  font-size: 28rpx;
  color: var(--text);
}

.sw-desc {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

/* ============ 关于 ============ */
.about-desc {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.7;
  margin-top: 16rpx;
}

/* ============ 导入弹层 ============ */
.import-area {
  width: 100%;
  height: 340rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  padding: 20rpx 22rpx;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.6;
}

.list-bottom-gap {
  height: 40rpx;
}

/* ============ 外观 · 自定义主题 ============ */
/* 圆圈里三段色：底色 / 卡片色 / 按钮色。不用 conic-gradient（小程序里支持不稳），
   三分竖条在 44rpx 的圆里已经能看清 */
.theme-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  /* 白色系的段落在浅色底/深色底上都可能糊掉，加一圈描边把它拎出来 */
  box-shadow: 0 0 0 1rpx var(--border);
  flex-shrink: 0;
}

.theme-dot-part {
  flex: 1;
  height: 100%;
}

/* 编辑入口那枚：和文字并排，比分段里的大一圈才不至于显得空 */
.theme-dot--lg {
  width: 68rpx;
  height: 68rpx;
}

.segment-item--dot {
  /* 圆比分段里的文字窄，别跟着 flex:1 撑满 */
  flex: 0 0 76rpx;
}

