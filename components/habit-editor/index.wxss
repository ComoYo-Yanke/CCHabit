/* 图标选择 */
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-cell {
  width: 92rpx;
  height: 92rpx;
  border-radius: var(--r-md);
  background: var(--surface-2);
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  transition: all 0.15s ease;
}

.icon-cell--on {
  transform: scale(1.05);
}

/* 自定义格子：虚线边框，和预设区分开；没填内容时显示一个「＋」 */
.icon-cell--custom {
  border-style: dashed;
  border-color: var(--border);
  color: var(--text-3);
}

/* 颜色选择 */
.color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.color-cell {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  transition: transform 0.15s ease;
}

.color-cell--on {
  border-color: rgba(255, 255, 255, 0.7);
  transform: scale(1.08);
}

.color-check {
  width: 34rpx;
  height: 34rpx;
}

/* 单位 chips */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  height: 66rpx;
  padding: 0 26rpx;
  border-radius: 33rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  color: var(--text-2);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.chip--on {
  color: var(--text);
}

/* 启用开关行 */
.switch-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 10rpx;
}

.switch-title {
  font-size: 28rpx;
  color: var(--text);
}

.switch-desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}
