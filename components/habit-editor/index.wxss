/* 图标选择 */
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-cell {
  width: 92rpx;
  height: 92rpx;
  border-radius: var(--r-md);
  background: var(--surface-2);
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  transition: all 0.15s ease;
}

.icon-cell--on {
  transform: scale(1.05);
}

/* 自定义格子：虚线边框，和预设区分开；没填内容时显示一个「＋」 */
.icon-cell--custom {
  border-style: dashed;
  border-color: var(--border);
  color: var(--text-3);
}

/* 颜色选择
 *
 * 尺寸是按「一行放下九个」倒推的：弹层内容宽 694rpx（750 - .sheet-body 左右各 28），
 * 9 × 62 + 8 × 14 = 670，留了 24rpx 余量。
 * 原来 72rpx + 20rpx 的间距在八个预设时就已经放不下（716 > 694），
 * 第八个会掉到第二行；加上自定义那格更是要走两行 —— 索性一起收进来排成一排。
 */
.color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.color-cell {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  transition: transform 0.15s ease;
}

.color-cell--on {
  border-color: var(--ring);
  transform: scale(1.08);
}

.color-check {
  width: 34rpx;
  height: 34rpx;
}

/* 自定义色那一格：没调过时是虚线圈 + 一个「＋」，调过就直接显示那个色 */
.color-cell--custom {
  border-color: var(--border);
  border-style: dashed;
}

/* 选中时要盖住上面那条虚线：两个类的权重一样，靠这条更具体的选择器压回来，
   否则调好的颜色选中了却还是灰虚线圈 */
.color-cell--custom.color-cell--on {
  border-style: solid;
  border-color: var(--ring);
}

.color-plus {
  font-size: 34rpx;
  line-height: 1;
  color: var(--text-3);
}

/* 三根 RGB 滑块。和 theme-editor 的 .sl-* 同名同观感，
   但那边定义在页面 wxss 里不跨页，组件里得自成一份 */
.color-custom {
  margin-top: 22rpx;
  padding: 0 4rpx;
}

.sl-row {
  margin-top: 14rpx;
}

.sl-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-2);
}

.sl-val {
  font-size: 22rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.sl-row slider {
  margin: 0 -8rpx;
}

/* 单位 chips */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  height: 66rpx;
  padding: 0 26rpx;
  border-radius: 33rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  color: var(--text-2);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.chip--on {
  color: var(--text);
}

/* 启用开关行 */
.switch-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 10rpx;
}

.switch-title {
  font-size: 28rpx;
  color: var(--text);
}

.switch-desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}
