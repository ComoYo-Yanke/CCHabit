<!--
  catchtouchmove：挡住冒泡到页面的滑动，否则在弹层上拖会滚动背后那一屏（见 checkin-sheet 顶部注释）。
  mounted / active 两级状态：收起时必须 display:none，否则原生组件（input）不认 opacity，
  会在主页上留下「不完全可见」的残影 —— 详见 app.wxss 的 .mask。
-->
<view class="mask {{mounted ? 'mask--mounted' : ''}} {{active ? 'mask--on' : ''}}" catchtouchmove="noop" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head sheet-head--acts">
      <text class="sheet-title ellipsis">{{isEdit ? '编辑习惯' : '新建习惯'}}</text>
      <!-- 确认按钮绝对定位悬浮在「×」左边：不再依赖主体让位，见 app.wxss 的 .sheet-acts -->
      <view class="sheet-acts">
        <view wx:if="{{isEdit}}" class="sheet-ok sheet-ok--danger" bindtap="onDelete">删除</view>
        <view class="sheet-ok" style="background: {{form.color}};" bindtap="onSubmit">{{isEdit ? '保存' : '创建'}}</view>
      </view>
      <view class="sheet-close press" bindtap="onClose">
        <view class="ic ic-close-idle"></view>
      </view>
    </view>

    <!-- 必须是 scroll-view：普通 view 的 overflow 滚动挂在 WebView 的 touchmove 上，
         会被遮罩的 catchtouchmove 吃掉，真机上滑不动。详见 app.wxss 的 .sheet-body -->
    <scroll-view scroll-y class="sheet-body" show-scrollbar="{{false}}">
      <!-- 名称 -->
      <view class="field">
        <view class="field-label">名称</view>
        <input
          class="field-input {{nameError ? 'field-input--error' : ''}}"
          value="{{form.name}}"
          data-field="name"
          maxlength="12"
          placeholder="例如：背单词"
          placeholder-class="ph"
          bindinput="onInput"
          adjust-position="{{true}}"
        />
        <view wx:if="{{nameError}}" class="field-error">{{nameError}}</view>
      </view>

      <!-- 图标：预设 emoji + 自定义（emoji / 字母 / 文字） -->
      <view class="field">
        <view class="field-label">
          图标
          <text class="field-hint">点「自定义」可填 emoji、字母或 1-2 个字</text>
        </view>
        <view class="icon-grid">
          <view
            wx:for="{{icons}}"
            wx:key="*this"
            class="icon-cell {{form.icon === item ? 'icon-cell--on' : ''}}"
            style="{{form.icon === item ? 'border-color:' + form.color + ';background:' + form.color + '22' : ''}}"
            data-icon="{{item}}"
            bindtap="onPickIcon"
          >{{item}}</view>
          <!-- 自定义格子：选中后下方出现输入框；格子里回显当前填的值 -->
          <view
            class="icon-cell icon-cell--custom {{customIcon ? 'icon-cell--on' : ''}}"
            style="{{customIcon ? 'border-color:' + form.color + ';background:' + form.color + '22' : ''}}"
            bindtap="onCustomIcon"
          >{{customIcon && form.icon ? form.icon : '＋'}}</view>
        </view>
        <input
          wx:if="{{customIcon}}"
          class="field-input field-input--mt"
          value="{{form.icon}}"
          data-field="icon"
          maxlength="2"
          placeholder="如 ⭐ / R / 跑"
          placeholder-class="ph"
          bindinput="onInput"
        />
      </view>

      <!-- 颜色 -->
      <view class="field">
        <view class="field-label">主题色</view>
        <view class="color-row">
          <view
            wx:for="{{colors}}"
            wx:key="*this"
            class="color-cell {{form.color === item ? 'color-cell--on' : ''}}"
            style="background: {{item}};"
            data-color="{{item}}"
            bindtap="onPickColor"
          >
            <view wx:if="{{form.color === item}}" class="ic ic-check-active color-check"></view>
          </view>
        </view>
      </view>

      <!-- 单位 -->
      <view class="field">
        <view class="field-label">
          数值单位
          <text class="field-hint">选填，用于统计累计数值（如总单词数）</text>
        </view>
        <view class="chip-row">
          <view
            wx:for="{{units}}"
            wx:key="*this"
            class="chip {{form.unit === item && !customUnit ? 'chip--on' : ''}}"
            style="{{form.unit === item && !customUnit ? 'background:' + form.color + '26;color:' + form.color + ';border-color:' + form.color + '66' : ''}}"
            data-unit="{{item}}"
            bindtap="onPickUnit"
          >{{item}}</view>
          <view
            class="chip {{customUnit ? 'chip--on' : ''}}"
            style="{{customUnit ? 'background:' + form.color + '26;color:' + form.color + ';border-color:' + form.color + '66' : ''}}"
            bindtap="onCustomUnit"
          >自定义</view>
        </view>
        <input
          wx:if="{{customUnit}}"
          class="field-input field-input--mt"
          value="{{form.unit}}"
          data-field="unit"
          maxlength="6"
          placeholder="输入单位，如 公里 / 毫升"
          placeholder-class="ph"
          bindinput="onInput"
        />
      </view>

      <!-- 快捷步长。曾经还有个「每日目标」，连同进度条一起撤掉了：
           打卡就是记个数，进度条是多余的一层概念。 -->
      <view class="field">
        <view class="field-label">
          快捷步长
          <text class="field-hint">打卡弹层里快捷按钮的幅度</text>
        </view>
        <input
          class="field-input"
          type="digit"
          value="{{form.step}}"
          data-field="step"
          placeholder="如 10"
          placeholder-class="ph"
          bindinput="onInput"
        />
      </view>

      <!-- 启用开关（仅编辑时展示，新建默认启用） -->
      <view wx:if="{{isEdit}}" class="switch-row">
        <view class="flex-1">
          <view class="switch-title">启用该习惯</view>
          <view class="switch-desc">关闭后不在首页展示，也不计入统计</view>
        </view>
        <switch checked="{{form.enabled}}" color="{{form.color}}" bindchange="onToggleEnabled" />
      </view>

      <view class="sheet-gap"></view>
    </scroll-view>
    <view class="sheet-safe"></view>
  </view>
</view>
