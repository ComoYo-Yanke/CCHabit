.chart-wrap {
  position: relative;
  width: 100%;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/*
 * 被弹层遮住时：必须 display:none。
 * 用 visibility: hidden 或 opacity: 0 都不行 —— 那样 canvas 依然存在、
 * 依然是原生控件、依然浮在最上层，只是「看不见内容」而挡住下面的弹层点击。
 */
.chart-wrap--hidden {
  display: none;
}

/* 无数据占位浮层 */
.chart-empty {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.chart-empty-dot {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 3rpx dashed var(--surface-3);
}

.chart-empty-text {
  font-size: 24rpx;
  color: var(--text-3);
}
