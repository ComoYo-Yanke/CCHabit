/*
 * 方形小卡。一行两个，所以宽度由 pages/index 的 .habit-cell 给，这里只管「是正方形」。
 *
 * 正方形不用 aspect-ratio（老 iOS 的 WebView 不认，卡片会被压成一条），
 * 而是 height: 0 + padding-bottom: 100% —— 百分比内边距按**包含块的宽度**解析，
 * 卡片宽多少就撑出多高，跟列数、屏幕宽窄都不用对数字。
 *
 * 代价是「高度由内边距撑出来，内容盒是 0 高」，所以里面的排版全交给一层
 * 绝对定位的 .hc-inner（四边贴齐，高度就有了）。这也是这两条样式必须写在
 * 一个规则里的原因：只有 .hc.card 这种两类的选择器才压得过 app.wxss 里单独一条 .card。
 */
.hc.card {
  position: relative;
  height: 0;
  padding: 0 0 100%;
  /* 内容比正方形高时裁掉，别漏到圆角外面 */
  overflow: hidden;
}

.hc-inner {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

/* ---- 顶部：图标 + 名称 ---- */
.hc-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.hc-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.hc-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

/* ---- 圆点阵 ---- */
.hc-heat {
  margin-top: 12rpx;
}

/* ---- 底部：连续天数 + 快捷打卡 ---- */
.hc-foot {
  /* margin-top: auto 把这一行摁到卡片底部，正方形多出来的那几像素都落在中间 */
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.hc-streak {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--warn);
}

.hc-fire {
  width: 24rpx;
  height: 24rpx;
}

.hc-meta-idle {
  font-size: 22rpx;
  color: var(--text-3);
}

.hc-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hc-btn-icon {
  width: 30rpx;
  height: 30rpx;
}

.hc-btn:active {
  opacity: 0.75;
}
