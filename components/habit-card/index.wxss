.hc {
  margin-bottom: 20rpx;
}

/* 顶部 */
.hc-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hc-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r-md);
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.hc-title-wrap {
  flex: 1;
  min-width: 0;
}

.hc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.hc-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
}

.hc-streak {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 23rpx;
  color: var(--warn);
}

.hc-fire {
  width: 26rpx;
  height: 26rpx;
}

.hc-meta-idle {
  font-size: 23rpx;
  color: var(--text-3);
}

.hc-today {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 12rpx 20rpx;
  min-width: 140rpx;
  flex-shrink: 0;
}

.hc-today-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}

.hc-today--done .hc-today-text {
  font-weight: 700;
}

.hc-today-label {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}

/* 进度条 */
.hc-progress {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
}

.hc-progress-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 5rpx;
  background: var(--surface-3);
  overflow: hidden;
}

.hc-progress-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.35s ease;
}

.hc-progress-text {
  font-size: 21rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
  min-width: 62rpx;
  text-align: right;
}

/* 热力概览 */
.hc-heat {
  margin-top: 24rpx;
}

/* 底部 */
.hc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  gap: 20rpx;
}

.hc-foot-hint {
  font-size: 22rpx;
  color: var(--text-3);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hc-btn {
  height: 62rpx;
  padding: 0 40rpx;
  border-radius: 31rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hc-btn:active {
  opacity: 0.75;
}
