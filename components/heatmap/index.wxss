.heat {
  width: 100%;
  overflow: hidden;
  /* 月份刻度行占的总高度（行高 20rpx + 下边距 8rpx）。
     星期列要和网格对齐就得跳过这一行，两个数字只在 .heat-months 里写一次，
     这里引用，免得改了一处忘另一处。 */
  --heat-month-h: 28rpx;
}

/* ---- 月份刻度 ---- */
/*
 * 刻度行和网格同属 .heat-inner，两者左边缘天然对齐，
 * 所以这里不再需要给星期列让位（早先它是 .heat-body 的兄弟才要 34rpx 的缩进）。
 */
.heat-months {
  display: flex;
  height: 20rpx;
  margin-bottom: 8rpx;
}

.heat-month-cell {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  line-height: 1;
  color: var(--text-3);
  /* 月份标签比它占的列宽，「10月」得允许溢出到相邻槽位上 */
  overflow: visible;
  white-space: nowrap;
}

/* ---- 主体 ---- */
.heat-body {
  display: flex;
  align-items: flex-start;
}

.heat-weekdays {
  display: flex;
  flex-direction: column;
  width: 34rpx;
  flex-shrink: 0;
}

/* 有月份刻度行时，星期列要下移一行才能和网格对齐 */
.heat--months .heat-weekdays {
  margin-top: var(--heat-month-h);
}

/* 高度必须与 .heat-cell 的 height + 行间距严格相等，否则刻度会串行 */
.heat-weekday {
  height: 26rpx;
  margin-bottom: 6rpx;
  font-size: 18rpx;
  color: var(--text-3);
  line-height: 26rpx;
}

/* 月份刻度 + 网格的公共容器：滚动模式里它被撑到 weeks × 32rpx 宽 */
.heat-inner {
  flex: 1;
  min-width: 0;
}

.heat-grid {
  display: flex;
  gap: 6rpx;
}

.heat-col {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  gap: 6rpx;
}

.heat-cell {
  width: 100%;
  height: 26rpx;
  border-radius: 7rpx;
  background: var(--heat-empty);
  transition: background-color 0.2s ease;
}

/* 未来日期：只占位不显色 */
.heat-cell--future {
  background: transparent;
}

/* ---- 横向滚动模式（首页的打卡总览） ---- */
/*
 * 容器宽度不定，没法再用 flex:1 等分，改成固定列宽：
 * 整块网格的宽度由 JS 算好（weeks × 32rpx）写在 .heat-inner 的内联样式上，
 * 32rpx 与 index.js 里的 COL_W 是同一个数，改一处要改两处。
 */
.heat--scroll .heat-scroll {
  flex: 1;
  min-width: 0;
}

/* 列宽自带间距，flex 的 gap 就不需要了 */
.heat--scroll .heat-grid,
.heat--scroll .heat-months {
  gap: 0;
}

.heat--scroll .heat-col,
.heat--scroll .heat-month-cell {
  flex: none;
  width: 32rpx;
}

/* 32rpx 的列里只画 26rpx，右边留出的 6rpx 就是列间距 */
.heat--scroll .heat-cell {
  width: 26rpx;
}

/* ---- 紧凑模式（习惯卡片内） ---- */
.heat--compact .heat-months,
.heat--compact .heat-weekdays {
  display: none;
}

.heat--compact .heat-grid,
.heat--compact .heat-col {
  gap: 5rpx;
}

.heat--compact .heat-cell {
  height: 20rpx;
  border-radius: 5rpx;
}

/* ---- 圆点模式（首页卡片） ---- */
/*
 * 要的是**正圆**，所以格子得先是正方形。
 * 不能写 `height: 100%`（父元素没有确定高度），也不写死 rpx ——
 * 列宽是 flex 等分出来的，写死了就对不上。这里用 padding-bottom: 100%：
 * 百分比内边距按**包含块的宽度**解析，而包含块正是这一列，
 * 于是格子高度 = 列宽，天然是正方形，改列数 / 改卡片宽度都不用跟着改数字。
 * 紧接其后的 .heat--compact .heat-cell--dot 是为了压过上面那条紧凑模式
 * （它写死了 height: 20rpx 和 5rpx 圆角）。
 */
.heat--compact .heat-cell--dot {
  height: 0;
  padding-bottom: 100%;
  border-radius: 50%;
}

/* ---- 图例 ---- */
.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 18rpx;
}

.heat-legend-text {
  font-size: 20rpx;
  color: var(--text-3);
  margin: 0 4rpx;
}

.heat-legend-cell {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
}
