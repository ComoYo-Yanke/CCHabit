<!--
  网格本体做成 template：非滚动模式和滚动模式要用同一份内容，
  区别只在外面套的是普通 view 还是 scroll-view。
  复制一份标记出来迟早会改歪其中一份，所以只在结构上分叉。
-->
<template name="heatCells">
  <!-- 月份刻度：与下方每一列一一对齐 -->
  <view wx:if="{{showMonths}}" class="heat-months">
    <view wx:for="{{monthSlots}}" wx:key="index" class="heat-month-cell">
      <text wx:if="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 主体：横向 N 列 × 纵向 7 行（周一到周日）。
       每格的填充色由 js 算好放在 cell.bg 上（色阶 / 圆点是两套规则，见 index.js 的 fillOf） -->
  <view class="heat-grid">
    <view wx:for="{{columns}}" wx:key="index" class="heat-col">
      <view
        wx:for="{{item}}"
        wx:for-item="cell"
        wx:key="date"
        class="heat-cell {{dot ? 'heat-cell--dot' : ''}} {{cell.future ? 'heat-cell--future' : ''}}"
        style="{{cell.future ? '' : 'background:' + cell.bg}}"
        data-date="{{cell.date}}"
        bindtap="onCellTap"
      ></view>
    </view>
  </view>
</template>

<!-- showMonths && !compact 决定星期列要不要跳过顶部那一行月份刻度 -->
<view class="heat {{compact ? 'heat--compact' : ''}} {{scroll ? 'heat--scroll' : ''}} {{showMonths && !compact ? 'heat--months' : ''}}">
  <view class="heat-body">
    <!-- 星期刻度：7 个槽位与右侧 7 行一一对应，只标注 一/三/五/日。
         放在滚动区之外，横向拖动时它不跟着跑。 -->
    <view wx:if="{{!compact}}" class="heat-weekdays">
      <view wx:for="{{['一','','三','','五','','日']}}" wx:key="index" class="heat-weekday">{{item}}</view>
    </view>

    <!-- 滚动模式：全部历史一列列铺开，初始停在最右（今天），向左拖看更早的 -->
    <scroll-view
      wx:if="{{scroll}}"
      scroll-x
      class="heat-scroll"
      scroll-left="{{scrollLeft}}"
      show-scrollbar="{{false}}"
    >
      <view class="heat-inner" style="width: {{gridWidth}}rpx;">
        <template is="heatCells" data="{{columns, monthSlots, showMonths, dot}}" />
      </view>
    </scroll-view>

    <!-- 普通模式：每列 flex:1 等分容器，整块正好铺满 -->
    <view wx:else class="heat-inner">
      <template is="heatCells" data="{{columns, monthSlots, showMonths, dot}}" />
    </view>
  </view>

  <!-- 图例 -->
  <view wx:if="{{showLegend && !compact}}" class="heat-legend">
    <text class="heat-legend-text">少</text>
    <view class="heat-legend-cell" style="background: var(--heat-empty)"></view>
    <view class="heat-legend-cell" style="background: var(--heat-1)"></view>
    <view class="heat-legend-cell" style="background: var(--heat-2)"></view>
    <view class="heat-legend-cell" style="background: var(--heat-3)"></view>
    <view class="heat-legend-cell" style="background: var(--heat-4)"></view>
    <text class="heat-legend-text">多</text>
  </view>
</view>
