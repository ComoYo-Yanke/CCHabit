/* 头部习惯信息 */
.ci-habit {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.ci-habit-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r-md);
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.ci-habit-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

/* 日期展示（只读，不可切换） */
.ci-date {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 12rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
}

/* 过去的日子压暗一档，和「今天」在视觉上就分得开 */
.ci-date--past {
  opacity: 0.72;
}

.ci-date-cal {
  width: 32rpx;
  height: 32rpx;
}

.ci-date-text {
  font-size: 28rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.ci-date-badge {
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

/* 只读提示条 */
.ci-lock {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-3);
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 16rpx 20rpx;
  margin-bottom: 28rpx;
  text-align: center;
}

/* 目标进度 */
.ci-progress {
  margin-bottom: 28rpx;
}

.ci-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ci-progress-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--surface-3);
  overflow: hidden;
}

.ci-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 大号数值输入 */
.ci-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0 26rpx;
}

.ci-value-input {
  min-width: 120rpx;
  max-width: 420rpx;
  text-align: center;
  font-size: 45rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.ci-value-ph {
  color: var(--surface-3);
  font-size: 96rpx;
  font-weight: 700;
}

.ci-value-unit {
  font-size: 30rpx;
  color: var(--text-3);
}

/* 快捷档位 */
.ci-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 30rpx;
}

/* 备注 */
.ci-note-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--text-3);
  padding: 18rpx 0;
}

.ci-note-icon {
  width: 30rpx;
  height: 30rpx;
}

.ci-note-input {
  margin-bottom: 10rpx;
}

/* 当天记录 */
.ci-records {
  margin-top: 20rpx;
}

.ci-records-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ci-record {
  display: flex;
  align-items: center;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid transparent;
  transition: border-color 0.15s ease;
}

.ci-record--editing {
  border-color: var(--accent);
}

.ci-record-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ci-record-value {
  font-size: 34rpx;
  font-weight: 700;
}

.ci-record-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 6rpx;
  opacity: 0.75;
}

.ci-record-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
  min-width: 0;
}

.ci-record-note {
  max-width: 240rpx;
}

.ci-record-del {
  width: 60rpx;
  height: 60rpx;
  margin-right: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ci-record-del-icon {
  width: 32rpx;
  height: 32rpx;
}
