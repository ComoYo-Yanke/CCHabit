<!--
  catchtouchmove 必须加在遮罩上：遮罩是固定满屏的，但触摸事件仍会冒泡到页面，
  手指在弹层上滑动（尤其是拖头部 / 底部按钮，或 scroll-view 已经滑到头继续拖）时
  滚的是背后那一屏，弹层自己纹丝不动 —— 用户看到的就是「滑的是背景主屏」。
  这里 catch 住，事件到遮罩为止。scroll-view 自己的滚动由它内部处理，
  不受影响（事件是先到 scroll-view 再冒泡上来的）。
-->
<view class="mask {{show ? 'mask--on' : ''}}" catchtouchmove="noop" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <!-- 头部：习惯信息 -->
    <view class="sheet-head sheet-head--acts">
      <view class="ci-habit">
        <view class="ci-habit-icon" style="background: {{habit.color}}22; border-color: {{habit.color}}55;">
          {{habit.icon}}
        </view>
        <view class="flex-1">
          <view class="sheet-title ellipsis">{{habit.name}}</view>
          <view class="ci-habit-sub">
            {{readonly ? '当天' : '今日'}}已打卡 {{dayCount}} 次 · 累计 {{dayTotalText}}{{habit.unit}}
          </view>
        </view>
      </view>
      <!-- 打卡按钮绝对定位悬浮在「×」左边：不再依赖主体让位，见 app.wxss 的 .sheet-acts -->
      <view class="sheet-acts">
        <view wx:if="{{editingId && !readonly}}" class="sheet-ok sheet-ok--ghost" bindtap="onCancelEdit">取消</view>
        <view wx:if="{{!readonly}}" class="sheet-ok" style="background: {{habit.color}};" bindtap="onSubmit">
          {{editingId ? '保存' : '打卡'}}
        </view>
      </view>
      <view class="sheet-close press" bindtap="onClose">
        <view class="ic ic-close-idle"></view>
      </view>
    </view>

    <!-- view 而不是 scroll-view，理由见 app.wxss 的 .sheet-body -->
    <view class="sheet-body">
      <!--
        日期只作展示，不再提供「前一天 / 后一天 / 系统日期选择器」。
        打卡只能记在当天：改过去的数据等于伪造历史，改未来更是没有意义，
        所以这里连入口都不给。过去的日子仍可从日历/历史点开，但是只读回看。
      -->
      <view class="ci-date {{readonly ? 'ci-date--past' : ''}}">
        <view class="ic ic-calendar-idle ci-date-cal"></view>
        <text class="ci-date-text">{{activeDate}}</text>
        <text class="ci-date-badge">{{dateLabel}}</text>
      </view>

      <view wx:if="{{readonly}}" class="ci-lock">
        <text>只能打卡当天，历史记录不可修改</text>
      </view>

      <!-- 打卡进度（设了目标就展示，只读时也照常显示） -->
      <view wx:if="{{habit.target > 0}}" class="ci-progress">
        <view class="ci-progress-head">
          <text class="f-24 t-3">目标进度</text>
          <text class="f-24 t-accent mono-num">{{progressText}}</text>
        </view>
        <view class="ci-progress-bar">
          <view class="ci-progress-fill" style="width: {{progress}}%; background: {{habit.color}};"></view>
        </view>
      </view>

      <!-- 录入区：只在当天出现。过去的日子整块不渲染，避免出现「填了却提交不了」的死表单 -->
      <block wx:if="{{!readonly}}">
        <!-- 数值输入 -->
        <view class="ci-value">
          <input
            class="ci-value-input"
            type="digit"
            value="{{value}}"
            placeholder="0"
            placeholder-class="ci-value-ph"
            bindinput="onValueInput"
            adjust-position="{{true}}"
          />
          <text class="ci-value-unit">{{habit.unit || '次'}}</text>
        </view>

        <!-- 快捷档位 -->
        <view class="ci-quick">
          <view
            wx:for="{{quickList}}"
            wx:key="value"
            class="chip {{isQuickOn[item.value] ? 'chip--on' : ''}}"
            style="{{isQuickOn[item.value] ? 'background:' + habit.color + '26;color:' + habit.color + ';border-color:' + habit.color + '66' : ''}}"
            data-value="{{item.value}}"
            bindtap="onQuickPick"
          >{{item.label}}</view>
          <view
            wx:if="{{habit.target > 0}}"
            class="chip"
            data-step="{{habit.target}}"
            bindtap="onAppendStep"
          >累加目标</view>
        </view>

        <!-- 备注 -->
        <view class="ci-note-toggle press" bindtap="onToggleNote">
          <view class="ic ic-edit-idle ci-note-icon"></view>
          <text>{{noteOpen ? '收起备注' : '添加备注'}}</text>
        </view>
        <input
          wx:if="{{noteOpen}}"
          class="field-input ci-note-input"
          value="{{note}}"
          maxlength="40"
          placeholder="记录一点细节，如「第 3 章」"
          placeholder-class="ph"
          bindinput="onNoteInput"
          adjust-position="{{true}}"
        />
      </block>

      <!--
        当天记录列表。当天可点选修改、可删除；过去的日子去掉点击与删除入口，
        连删除按钮都不渲染 —— 只读就要是「看起来也不能改」，而不是点了才报错。
      -->
      <view wx:if="{{records.length}}" class="ci-records">
        <view class="ci-records-head">
          <text class="f-26 t-2">{{dateLabel}}的记录</text>
          <text wx:if="{{!readonly}}" class="f-24 t-3">点击数值可修改</text>
        </view>
        <view
          wx:for="{{records}}"
          wx:key="id"
          class="ci-record {{editingId === item.id ? 'ci-record--editing' : ''}}"
        >
          <view
            class="ci-record-main {{readonly ? '' : 'press'}}"
            data-id="{{item.id}}"
            bindtap="onEditRecord"
          >
            <view class="ci-record-value mono-num" style="color: {{habit.color}};">
              {{item.value}}<text class="ci-record-unit">{{item.unit}}</text>
            </view>
            <view class="ci-record-meta">
              <text>{{item.time}}</text>
              <text wx:if="{{item.note}}" class="ci-record-note ellipsis">· {{item.note}}</text>
            </view>
          </view>
          <view
            wx:if="{{!readonly}}"
            class="ci-record-del press"
            data-id="{{item.id}}"
            catchtap="onDeleteRecord"
          >
            <view class="ic ic-trash-idle ci-record-del-icon"></view>
          </view>
        </view>
      </view>

      <view wx:elif="{{readonly}}" class="empty" style="padding: 40rpx 0;">
        <view class="empty-desc">这一天没有打卡记录</view>
      </view>

      <view class="sheet-gap"></view>
      <view class="sheet-gap"></view>
    </view>

    <view class="sheet-safe"></view>
  </view>
</view>
