<view class="nav {{fixed ? 'nav--fixed' : ''}} {{scrolled ? 'nav--scrolled' : ''}}">
  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <view class="nav-bar" style="height: {{barHeight}}px;">
    <view wx:if="{{back}}" class="nav-back press" bindtap="onBack">
      <view class="ic ic-left-idle nav-back-icon"></view>
    </view>

    <view class="nav-title-wrap" style="padding-right: {{back ? 0 : rightGutter}}px;">
      <view class="nav-title">{{title}}</view>
      <view wx:if="{{subtitle}}" class="nav-subtitle">{{subtitle}}</view>
    </view>

    <view class="nav-extra" style="padding-right: {{rightGutter}}px;">
      <slot name="right"></slot>
    </view>
  </view>
</view>

<!-- 固定模式下用等高铁占位，防止内容被遮挡 -->
<view wx:if="{{fixed}}" style="height: {{statusBarHeight + barHeight}}px;"></view>
