.nav {
  background: transparent;
}

.nav--fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 800;
  transition: background-color 0.2s ease, border-color 0.2s ease;
  border-bottom: 1rpx solid transparent;
}

/* 滚动后浮现背景，避免文字与内容重叠 */
.nav--fixed.nav--scrolled {
  background: rgba(14, 16, 20, 0.92);
  border-bottom-color: var(--border-soft);
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  margin-left: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-subtitle {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}

.nav-extra {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
